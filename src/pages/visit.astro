---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { features as f } from '../config/features';

// Contact page (route stays /visit). Everything below comes from settings.json.
const c = (await getEntry('copy', 'visit'))!.data;
const { address, hours, email, ordersEmail } = siteConfig;
const { instagram, instagramHandle } = siteConfig.links;
---

<BaseLayout title={c.title} schema="localbusiness">
  <header class="page-head">
    <div class="container">
      <h1>{noOrphan(c.title ?? '')}</h1>
    </div>
  </header>

  <section class="visit" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container visit-grid">
      <div class="visit-info">
        <div class="info-block">
          <h2 class="info-h smallcaps">Hours</h2>
          <ul class="hours" role="list">
            {hours.map((h) => (
              <li>
                <span class="mono">{h.days}</span>
                <span class="mono hours-time">{h.close ? `${h.open}–${h.close}` : h.open}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="info-block">
          <h2 class="info-h smallcaps">Address</h2>
          <address class="addr">
            <p>{address.street}<br />{address.city}, {address.state} {address.zip}</p>
            <p class="addr-contact">
              <a href={`mailto:${email}`}>{email}</a><br />
              <a href={`mailto:${ordersEmail}`}>{ordersEmail}</a> for larger orders<br />
              <a href={instagram} target="_blank" rel="noopener">{instagramHandle}</a>
            </p>
          </address>
        </div>
      </div>

      <div class="visit-map">
        {/* MAP SLOT: the hand-drawn map image goes here in the photos phase.
            Intentionally empty for now (the Google Maps embed was removed). */}
        <a
          class="map-link mono"
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${address.street}, ${address.city}, ${address.state} ${address.zip}`)}`}
          target="_blank"
          rel="noopener"
        >
          Open in Google Maps ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>

  .visit { padding-block: var(--space-8) var(--space-9); }
  .visit-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-7); align-items: start; }

  .info-block + .info-block { margin-top: var(--space-7); }
  /* Sub-labels share the site-wide label language (mono tracked + clay dash). */
  .info-h {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-body);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  .hours { display: flex; flex-direction: column; gap: var(--space-2); max-width: 360px; }
  .hours li { display: flex; justify-content: space-between; gap: var(--space-3); }
  .hours-time { color: var(--muted); }
  .addr { font-style: normal; line-height: 1.8; }
  .addr-contact { margin-top: var(--space-3); }
  .addr-contact a { color: var(--burgundy); }

  .map-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* tap target */
    margin-top: var(--space-3);
    font-size: clamp(13px, calc(13px + (100vw - 1920px) * 0.002344), 14.5px);
    color: var(--burgundy);
  }
  @media (hover: hover) and (pointer: fine) {
    .map-link:hover { color: var(--burgundy); }
  }

  @media (max-width: 820px) {
    .visit-grid { grid-template-columns: 1fr; }
  }
</style>
