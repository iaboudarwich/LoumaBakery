---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { features as f } from '../config/features';
import Img from '../components/Img.astro';
import Doodle from '../components/Doodle.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import { resolveImage as pick } from '../lib/images';

// Every word comes from copy.json ("home"), every photo and its alt text from
// images.json, the address and hours from settings.json.
const home = (await getEntry('copy', 'home'))!.data;
const images = (await getEntry('images', 'images'))!.data;
const heroPhoto = pick(images.hero);
const g = images.homeGallery.map((p) => ({ photo: pick(p.image), alt: p.alt }));
const { address, hours, directionsUrl } = siteConfig;

// Hero, art-directed. Wide screens get the landscape frame. Narrow screens
// show a 72svh-tall slot, a portrait crop of the same frame, so they get that
// crop (5:8, centred, the crop object-fit: cover would make anyway) instead
// of a 3000px landscape file. Keeps the phone LCP AVIF <=150KB (CLAUDE.md);
// quality is tuned against the file a 390px DPR-3 phone picks.
const HERO_QUALITY = 45;
const NARROW = '(max-width: 47.99rem)';
const variants = async (widths: number[], ratio: number | undefined, format: 'avif' | 'webp') =>
  heroPhoto
    ? (await Promise.all(widths.map((w) => getImage({ src: heroPhoto, width: w, ...(ratio ? { height: Math.round(w / ratio), fit: 'cover' as const, position: 'center' } : {}), format, quality: HERO_QUALITY }))))
        .map((img, i) => `${img.src} ${widths[i]}w`).join(', ')
    : '';
const WIDE_W = [1200, 1600, 2000, 2400, 3000];
const NARROW_W = [600, 900, 1200];
const hero = heroPhoto && {
  narrowAvif: await variants(NARROW_W, 5 / 8, 'avif'),
  narrowWebp: await variants(NARROW_W, 5 / 8, 'webp'),
  wideAvif: await variants(WIDE_W, undefined, 'avif'),
  wideWebp: await variants(WIDE_W, undefined, 'webp'),
  fallback: await getImage({ src: heroPhoto, width: 1600, format: 'jpeg', quality: 70 }),
};

const reveal = f.reveal ? 'reveal' : undefined;
---

<BaseLayout schema="bakery" description={home.tagline}>
  {/* 1. Hero: the photo alone, edge to edge. No text, no overlay. */}
  {hero && (
    <section class="home-hero">
      <picture class="hero-photo">
        <source media={NARROW} type="image/avif" srcset={hero.narrowAvif} sizes="100vw" />
        <source media={NARROW} type="image/webp" srcset={hero.narrowWebp} sizes="100vw" />
        <source type="image/avif" srcset={hero.wideAvif} sizes="100vw" />
        <source type="image/webp" srcset={hero.wideWebp} sizes="100vw" />
        <img src={hero.fallback.src} width={hero.fallback.attributes.width} height={hero.fallback.attributes.height} alt={images.heroAlt} class="img-cover" loading="eager" decoding="auto" fetchpriority="high" />
      </picture>
    </section>
  )}

  {/* 2. Tagline band: the baguette mark over the tagline. */}
  <section class="section tagline-band">
    <div class="container tagline-inner" data-anim={reveal}>
      <Doodle name="baguette" size={140} color="red" animate={f.doodleDraw} class="tagline-mark" />
      <h1 class="display tagline">{home.tagline}</h1>
    </div>
  </section>

  {/* 3. Photo pair: portrait 5 columns, landscape 7, top-aligned. */}
  <section class="section">
    <div class="container grid-12">
      {g[0]?.photo && <Img src={g[0].photo} alt={g[0].alt} class="ph ph--portrait" style="--span: 5" sizes="(max-width: 47.99rem) 100vw, min(40vw, 560px)" />}
      {g[1]?.photo && <Img src={g[1].photo} alt={g[1].alt} class="ph ph--landscape" style="--span: 7" sizes="(max-width: 47.99rem) 100vw, min(57vw, 800px)" />}
    </div>
  </section>

  {/* 4. Body: the two paragraphs in a centred column. */}
  <section class="section">
    <div class="container" data-anim={reveal}>
      <div class="home-body">{home.body.map((p) => <p class="lead">{p}</p>)}</div>
    </div>
  </section>

  {/* 5. Photo row: two equal portraits. */}
  <section class="section">
    <div class="container grid-12">
      {g[2]?.photo && <Img src={g[2].photo} alt={g[2].alt} class="ph ph--portrait" style="--span: 6" sizes="(max-width: 47.99rem) 100vw, min(48vw, 680px)" />}
      {g[3]?.photo && <Img src={g[3].photo} alt={g[3].alt} class="ph ph--portrait" style="--span: 6" sizes="(max-width: 47.99rem) 100vw, min(48vw, 680px)" />}
    </div>
  </section>

  {/* 6. Visit band: burgundy, butter text. Address left, hours right. */}
  <section class="section block--burgundy visit-band" aria-labelledby="visit-band-h">
    <div class="container grid-12" data-anim={reveal}>
      <div class="visit-where" style="--span: 7">
        <Doodle name="sun" size={72} color="butter" animate={f.doodleDraw} class="visit-sun" />
        <h2 id="visit-band-h" class="visually-hidden">Visit</h2>
        <address class="visit-address">{address.street}<br />{address.city}, {address.state} {address.zip}</address>
      </div>
      <ul class="visit-hours" role="list" style="--start: 9; --span: 4">
        {hours.map((h) => (
          <li>
            <span>{h.days}</span>
            <span>{h.close ? `${h.open}–${h.close}` : h.open}</span>
          </li>
        ))}
      </ul>
      <p class="visit-directions"><a href={directionsUrl} target="_blank" rel="noopener">Get directions</a></p>
    </div>
  </section>

  {/* 7. Photo row: landscape 8 columns, portrait 4. */}
  <section class="section">
    <div class="container grid-12">
      {g[4]?.photo && <Img src={g[4].photo} alt={g[4].alt} class="ph ph--landscape" style="--span: 8" sizes="(max-width: 47.99rem) 100vw, min(65vw, 900px)" />}
      {g[5]?.photo && <Img src={g[5].photo} alt={g[5].alt} class="ph ph--portrait" style="--span: 4" sizes="(max-width: 47.99rem) 100vw, min(32vw, 440px)" />}
    </div>
  </section>

  {/* 8. Instagram strip. */}
  <section class="section" aria-labelledby="ig-h">
    <div class="container">
      {home.instagramTitle && <h2 id="ig-h" class="h2 ig-title">{home.instagramTitle}</h2>}
      <InstagramStrip />
    </div>
  </section>
  {/* 9. Footer (with the newsletter, target of #newsletter) comes from BaseLayout. */}
</BaseLayout>

<style>
  /* 1. Hero: full-bleed, the photo exactly as shot. */
  .home-hero { line-height: 0; }
  .hero-photo {
    display: block;
    width: 100%;
    height: min(88svh, 960px);
  }
  @media (max-width: 47.99rem) {
    .hero-photo { height: 72vh; height: 72svh; }
  }

  /* 2. Tagline band. */
  .tagline-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--block-gap); }
  .tagline-inner :global(.tagline-mark) { width: clamp(96px, 10vw, 140px); }
  .tagline { max-width: 16ch; }

  /* 4. Body copy: a centred column, max 34em, text set left for reading. */
  .home-body { max-width: 34em; margin-inline: auto; }
  .home-body .lead { max-width: none; }

  /* 6. Visit band. */
  .visit-band :global(.visit-sun) { margin-bottom: var(--block-gap); }
  .visit-address {
    font-style: normal;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: 1.1;
    color: var(--butter);
  }
  .visit-hours { margin: 0; padding: 0; align-self: end; display: grid; gap: var(--space-2); font-size: var(--fs-lead); }
  .visit-hours li { display: flex; justify-content: space-between; gap: var(--space-4); font-weight: 500; font-variant-numeric: tabular-nums; }
  .visit-directions { grid-column: 1 / -1; }
  .visit-directions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: var(--butter);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* 8. Instagram. */
  .ig-title { margin-bottom: var(--block-gap); }
</style>
