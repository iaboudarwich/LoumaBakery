---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import Img from './Img.astro';
import { resolveImage } from '../lib/images';

// Up to six square tiles from src/data/instagram.json (CMS: "Instagram strip"),
// each linking to the Instagram profile in a new tab, then the handle as a link.
// Tiles with no image (or a photo that can't be found) are skipped; with none
// left, only the handle renders.
const tiles = (await getCollection('instagram'))
  .slice(0, 6)
  .map((t) => ({ photo: resolveImage(t.data.image), alt: t.data.alt }))
  .filter((t) => t.photo);
const { instagram, instagramHandle } = siteConfig.links;
---

<div class="ig-strip">
  {tiles.length > 0 && (
    <ul class="ig-tiles" role="list">
      {tiles.map((t) => (
        <li>
          <a class="ig-tile" href={instagram} target="_blank" rel="noopener">
            <Img src={t.photo!} alt={t.alt} class="ig-img" sizes="(max-width: 47.99rem) 50vw, min(33vw, 420px)" widths={[320, 480, 640, 840, 1040]} />
          </a>
        </li>
      ))}
    </ul>
  )}
  <p class="ig-handle"><a href={instagram} target="_blank" rel="noopener">{instagramHandle}</a></p>
</div>

<style>
  /* Big squares: 3 columns x 2 rows from 48rem up, 2 x 3 on phones, the
     page's --block-gap between them. Photos render as shot (square crop via
     the slot's aspect ratio). The srcset tops out at 1040w, enough for the
     ~416px tile at 1440 on a DPR-2 screen. */
  .ig-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--block-gap);
    margin: 0;
    padding: 0;
  }
  @media (min-width: 48rem) { .ig-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .ig-tile { display: block; }
  .ig-tile :global(.ig-img) { aspect-ratio: 1; }
  .ig-handle { margin-top: var(--block-gap); }
  .ig-handle a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; }
</style>
