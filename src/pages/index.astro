---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { siteConfig } from '../config/site';
import { features as f } from '../config/features';
import Img from '../components/Img.astro';
import Doodle from '../components/Doodle.astro';
import PenDraw from '../components/PenDraw.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import { resolveImage as pick } from '../lib/images';

// Every word comes from copy.json ("home"), every photo and its alt text from
// images.json, the address and hours from settings.json.
const home = (await getEntry('copy', 'home'))!.data;
const images = (await getEntry('images', 'images'))!.data;
const heroPhoto = pick(images.hero);
const g = images.homeGallery.map((p) => ({ photo: pick(p.image), alt: p.alt }));
const { address, hours, directionsUrl } = siteConfig;

// Split hero: the photo fills the right 7 columns (a tall box on wide
// screens, 4:5 on phones), so every size is a centred 4:5 crop of the frame,
// the crop object-fit: cover would make anyway. Keeps the phone LCP AVIF
// <=150KB (CLAUDE.md); quality is tuned against the file a 390px DPR-3 phone
// picks (1200w).
const HERO_QUALITY = 45;
const HERO_W = [600, 900, 1200, 1500, 1800];
const HERO_RATIO = 4 / 5;
const variants = async (format: 'avif' | 'webp') =>
  heroPhoto
    ? (await Promise.all(HERO_W.map((w) => getImage({ src: heroPhoto, width: w, height: Math.round(w / HERO_RATIO), fit: 'cover', position: 'center', format, quality: HERO_QUALITY }))))
        .map((img, i) => `${img.src} ${HERO_W[i]}w`).join(', ')
    : '';
const hero = heroPhoto && {
  avif: await variants('avif'),
  webp: await variants('webp'),
  fallback: await getImage({ src: heroPhoto, width: 1200, height: 1500, fit: 'cover', position: 'center', format: 'jpeg', quality: 70 }),
};
// The photo's rendered width: the full column on phones; on wide screens the
// larger of the 7-column box and the 4:5 crop scaled to the box height.
const HERO_SIZES = '(max-width: 47.99rem) 100vw, max(min(55vw, 790px), min(69vh, 688px))';

// One line under the tagline, built from Site settings: the street and city,
// then each open row of hours in short form ("Tue–Sun 7:30–2:30"). Each part
// stays on one line; the line breaks only between parts.
const shortDays = (d: string) => d.split(/\s*[–-]\s*/).map((x) => x.trim().slice(0, 3)).join('–');
const shortTime = (t: string) => t.replace(/\s*(AM|PM)\s*$/i, '');
const heroMeta = [
  `${address.street}, ${address.city}`,
  ...hours.filter((h) => h.close).map((h) => `${shortDays(h.days)} ${shortTime(h.open)}–${shortTime(h.close)}`),
];

const reveal = f.reveal ? 'reveal' : undefined;
---

<BaseLayout schema="bakery" description={describe([home.tagline, ...home.body])}>
  {/* 1. Split hero: the baguette, the tagline and the address line left (5
      columns), the photo right (7). Phones: the photo first, then the text. */}
  <section class="home-hero">
    <div class="container grid-12 hero-grid">
      <div class="hero-text">
        {/* The baguette: drawn on a pen loop (features.penDraw), else the filled mark. */}
        <div class="hero-mark-slot">
          {f.penDraw
            ? <PenDraw size={140} color="red" class="hero-mark" />
            : <Doodle name="baguette" size={140} color="red" animate={f.doodleDraw} class="hero-mark" />}
        </div>
        <h1 class="display hero-tagline">{home.tagline}</h1>
        <p class="label hero-meta">{heroMeta.map((part, i) => <>{i > 0 && ' · '}<span>{part}</span></>)}</p>
      </div>
      {hero && (
        <picture class="hero-photo">
          <source type="image/avif" srcset={hero.avif} sizes={HERO_SIZES} />
          <source type="image/webp" srcset={hero.webp} sizes={HERO_SIZES} />
          <img src={hero.fallback.src} width={hero.fallback.attributes.width} height={hero.fallback.attributes.height} alt={images.heroAlt} class="img-cover" loading="eager" decoding="auto" fetchpriority="high" />
        </picture>
      )}
    </div>
  </section>

  {/* 2. Photo pair: portrait 5 columns, landscape 7, top-aligned. */}
  <section class="section">
    <div class="container grid-12">
      {g[0]?.photo && <Img src={g[0].photo} alt={g[0].alt} class="ph ph--portrait" style="--span: 5" sizes="(max-width: 47.99rem) 100vw, min(40vw, 560px)" />}
      {g[1]?.photo && <Img src={g[1].photo} alt={g[1].alt} class="ph ph--landscape" style="--span: 7" sizes="(max-width: 47.99rem) 100vw, min(57vw, 800px)" />}
    </div>
  </section>

  {/* 3. Body: the two paragraphs in a centred column. */}
  <section class="section">
    <div class="container" data-anim={reveal}>
      <div class="home-body">{home.body.map((p) => <p class="lead">{p}</p>)}</div>
    </div>
  </section>

  {/* 4. Photo row: two equal portraits. */}
  <section class="section">
    <div class="container grid-12">
      {g[2]?.photo && <Img src={g[2].photo} alt={g[2].alt} class="ph ph--portrait" style="--span: 6" sizes="(max-width: 47.99rem) 100vw, min(48vw, 680px)" />}
      {g[3]?.photo && <Img src={g[3].photo} alt={g[3].alt} class="ph ph--portrait" style="--span: 6" sizes="(max-width: 47.99rem) 100vw, min(48vw, 680px)" />}
    </div>
  </section>

  {/* 5. Visit band: burgundy, butter text. Address left, hours right. */}
  <section class="section block--burgundy visit-band" aria-labelledby="visit-band-h">
    <div class="container grid-12" data-anim={reveal}>
      <div class="visit-where">
        <Doodle name="sun" size={72} color="butter" animate={f.doodleDraw} class="visit-sun" />
        <h2 id="visit-band-h" class="visually-hidden">Visit</h2>
        <address class="visit-address">{address.street}<br />{address.city}, {address.state} {address.zip}</address>
      </div>
      <ul class="hours-grid visit-hours" role="list">
        {hours.map((h) => (
          <li>
            <span>{h.days}</span>
            <span>{h.close ? `${h.open}–${h.close}` : h.open}</span>
          </li>
        ))}
      </ul>
      <p class="visit-directions"><a href={directionsUrl} target="_blank" rel="noopener">Get directions</a></p>
    </div>
  </section>

  {/* 6. Instagram strip. */}
  <section class="section" aria-labelledby="ig-h">
    <div class="container">
      {home.instagramTitle && <h2 id="ig-h" class="h2 ig-title">{home.instagramTitle}</h2>}
      <InstagramStrip />
    </div>
  </section>
  {/* The footer comes from BaseLayout. */}
</BaseLayout>

<style>
  /* 1. Split hero: min(86svh, 860px) tall on wide screens; the photo fills
     its column's height, exactly as shot (object-fit: cover). */
  .home-hero { padding-top: var(--block-gap); }
  .hero-grid { align-items: stretch; }
  .hero-text {
    --span: 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--block-gap);
    padding-block: var(--block-gap);
  }
  .hero-text :global(.hero-mark) { width: clamp(96px, 10vw, 140px); }
  .hero-meta { color: var(--burgundy); max-width: none; }
  .hero-meta span { white-space: nowrap; }
  .hero-photo {
    --start: 6;
    --span: 7;
    display: block;
    height: min(86vh, 860px);
    height: min(86svh, 860px);
  }
  /* Phones: the photo first at 4:5, then the text. */
  @media (max-width: 47.99rem) {
    .hero-photo { order: -1; height: auto; aspect-ratio: 4 / 5; }
    .hero-text { padding-block: 0; gap: var(--space-5); }
  }

  /* 3. Body copy: a centred column, max 44em, text set left for reading. */
  .home-body { max-width: 44em; margin-inline: auto; }
  .home-body .lead { max-width: none; }

  /* 5. Visit band. */
  .visit-band :global(.visit-sun) { margin-bottom: var(--block-gap); }
  .visit-address {
    font-style: normal;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-track);
    font-size: var(--fs-h2);
    line-height: 1.1;
    color: var(--butter);
  }
  .visit-hours { align-self: end; font-size: var(--fs-lead); }
  /* Address and hours side by side only where the hours have room on one
     line each; stacked below that. */
  @media (min-width: 64rem) {
    .visit-where { --span: 6; }
    .visit-hours { --start: 7; --span: 6; justify-self: end; }
  }
  .visit-directions { grid-column: 1 / -1; }
  .visit-directions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: var(--butter);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* 6. Instagram. */
  .ig-title { margin-bottom: var(--block-gap); }
</style>
