---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { features as f } from '../config/features';
import { siteConfig } from '../config/site';

const c = (await getEntry('copy', 'catering'))!.data;
const steps = c.steps ?? [];
const tiers = c.tiers ?? [];
// Earliest selectable event date (build date); blocks past dates.
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Catering" description={c.lede}>
  <header class="page-intro">
    <div class="container">
      {c.eyebrow && <p class="label page-label">{c.eyebrow}</p>}
      <h1 class="display">{noOrphan(c.title ?? '')}</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
    </div>
  </header>

  {/* Process */}
  {steps.length > 0 && (
    <section class="section process">
      <div class="container">
        <ol class="process-grid" data-anim={f.reveal ? 'reveal' : undefined} data-reveal-children>
          {steps.map((s) => (
            <li class="step">
              {/* Numbered markers removed by request; could return later as
                  small custom drawn-numeral images. */}
              <h2 class="step-title">{s.title}</h2>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {/* Tiers */}
  {tiers.length > 0 && (
    <section class="section block--white tiers cv-auto">
      <div class="container">
        <div class="sec-head"><p class="label sec-label">Options</p><h2 class="h2">Pick a starting point</h2></div>
        <ul class="tiers-grid" role="list" data-anim={f.reveal ? 'reveal' : undefined} data-reveal-children>
          {tiers.map((t) => (
            <li class="tier">
              {t.note && <span class="tier-note mono">{t.note}</span>}
              <h3 class="tier-name">{t.name}</h3>
              <p class="tier-price mono">{t.price}</p>
              <ul class="tier-items" role="list">
                {t.items.map((it) => <li>{it}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Inquiry form */}
  <section class="section inquiry cv-auto" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container narrow">
      <div class="sec-head">
        <p class="label sec-label">Start here</p><h2 class="h2">Catering inquiry</h2>
        {c.body.map((para) => <p>{para}</p>)}
      </div>
      <form
        name="catering"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="form-grid"
      >
        <input type="hidden" name="form-name" value="catering" />
        {/* Messages live in hidden elements, not form attributes: Netlify rewrites the
            <form> tag at deploy and mangles apostrophes in its attribute values. */}
        <span hidden data-form-msg="success">{siteConfig.forms.cateringSuccess}</span>
        <span hidden data-form-msg="error">{siteConfig.forms.error}</span>
        <p class="visually-hidden" aria-hidden="true"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field"><label for="cat-name">Name</label><input id="cat-name" name="name" type="text" required autocomplete="name" /></div>
        <div class="field"><label for="cat-email">Email</label><input id="cat-email" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
        <div class="field"><label for="cat-date">Event date</label><input id="cat-date" name="event-date" type="date" min={today} required /></div>
        <div class="field"><label for="cat-head">Headcount</label><input id="cat-head" name="headcount" type="number" min="1" inputmode="numeric" required /></div>
        <div class="field field--full"><label for="cat-msg">Message</label><textarea id="cat-msg" name="message" required></textarea></div>
        <div class="field--full"><button type="submit" class="btn btn-primary">Send inquiry</button></div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  /* Global system (tokens.css): container, --section-y rhythm, --fs-* scale. */
  .page-label { color: var(--burgundy); margin-bottom: var(--space-5); }
  .sec-head { margin-bottom: var(--block-gap); }
  .sec-label { color: var(--burgundy); margin-bottom: var(--space-2); }
  .narrow { max-width: calc(var(--container) * 2 / 3); }
  .process-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--block-gap); }
  .step-title { margin-bottom: var(--space-2); font-size: var(--fs-lead); line-height: 1.2; color: var(--ink); }
  .step::before { content: ''; display: block; width: 40px; height: 2px; background: var(--burgundy); margin-bottom: var(--space-4); }
  .tiers-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--block-gap); }
  .tier {
    position: relative;
    padding: calc(var(--block-gap) + var(--space-4)) var(--block-gap) var(--block-gap);
    background: var(--butter);
    border: 1px solid var(--hairline-strong);
  }
  .tier-note {
    position: absolute; top: -10px; left: var(--block-gap);
    background: var(--peach); color: var(--ink);
    font-size: var(--fs-small); letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.25rem 0.6rem;
  }
  .tier-name { font-size: var(--fs-lead); line-height: 1.2; color: var(--ink); }
  .tier-price { color: var(--burgundy); font-size: var(--fs-body); margin: var(--space-2) 0 var(--space-4); }
  .tier-items { display: flex; flex-direction: column; gap: var(--space-2); color: var(--body); }
  .tier-items li { padding-left: 1.2em; position: relative; }
  .tier-items li::before { content: '·'; position: absolute; left: 0; color: var(--burgundy); }
  .inquiry .sec-head > h2 + p { margin-top: var(--space-3); }
  @media (max-width: 47.99rem) {
    .process-grid, .tiers-grid { grid-template-columns: 1fr; }
  }
</style>
