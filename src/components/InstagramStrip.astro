---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import Img from './Img.astro';
import { resolveImage } from '../lib/images';

interface Props {
  /** The heading under the tiles (copy.json home.instagramTitle). */
  title?: string;
}
const { title } = Astro.props;

// Up to six square tiles from src/data/instagram.json (CMS: "Instagram strip"),
// each linking to the Instagram profile in a new tab, then the heading and
// the handle as a link. Tiles with no image (or a photo that can't be found)
// are skipped; with none left, only the heading and handle render.
const tiles = (await getCollection('instagram'))
  .slice(0, 6)
  .map((t) => ({ photo: resolveImage(t.data.image), alt: t.data.alt }))
  .filter((t) => t.photo);
const { instagram, instagramHandle } = siteConfig.links;
---

<div class="ig-strip">
  {tiles.length > 0 && (
    <ul class="ig-tiles" role="list">
      {tiles.map((t) => (
        <li>
          <a class="ig-tile" href={instagram} target="_blank" rel="noopener">
            <Img src={t.photo!} alt={t.alt} class="ig-img" sizes="(max-width: 47.99rem) 34vw, 17vw" widths={[240, 480, 720]} />
          </a>
        </li>
      ))}
    </ul>
  )}
  <div class="ig-follow">
    {title && <h2 id="ig-h" class="ig-title">{title}</h2>}
    <p class="ig-handle"><a href={instagram} target="_blank" rel="noopener">{instagramHandle}</a></p>
  </div>
</div>

<style>
  /* Edge to edge: six squares in one row from 48rem, three across on phones,
     --space-1 apart. Photos render as shot (square crop via the slot's
     aspect ratio). The srcset tops out at 720w: a tile is 240px at 1440 and
     about 320px at 1920 (DPR 2), 130px on a phone (DPR 3). */
  .ig-tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }
  @media (min-width: 48rem) { .ig-tiles { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .ig-tile { display: block; }
  .ig-tile :global(.ig-img) { aspect-ratio: 1; }

  /* "Follow along" and the handle, centred, display size in Owners 400. */
  .ig-follow {
    padding-block: var(--section-y);
    padding-inline: var(--gutter);
    text-align: center;
    font-size: var(--fs-display);
    line-height: 1.15;
  }
  .ig-title {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: var(--track-body);
    text-transform: none;
    color: inherit;
  }
  .ig-handle { max-width: none; }
  .ig-handle a { text-decoration-line: underline; }
</style>
