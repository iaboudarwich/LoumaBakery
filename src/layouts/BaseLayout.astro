---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { siteConfig, SITE_URL } from '../config/site';
import { features } from '../config/features';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// Self-hosted Owners faces (font-display: swap), served from public/fonts.
import '../styles/fonts.css';

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter image path (absolute or root-relative). */
  image?: string;
  /** schema.org / OG type. */
  ogType?: 'website' | 'article';
  /** Make the nav transparent over a hero (page provides its own hero bg). */
  transparentNav?: boolean;
  /** Keep the page out of search indexes (internal pages). */
  noindex?: boolean;
  /** schema.org structured data (Bakery on home and visit), or none. Both values emit the same entity. */
  schema?: 'bakery' | 'localbusiness';
  /** Show the footer newsletter. Pages with their own signup (home) pass false. */
  footerNewsletter?: boolean;
  /** Preload the hero headline face (home) so its late swap doesn't shift layout. */
}

const {
  title,
  description = siteConfig.tagline,
  image = '/og-default.jpg', // center crop of src/assets/img/hero.jpg (Kayla shoot)
  ogType = 'website',
  transparentNav = false,
  noindex = false,
  schema,
  footerNewsletter = true,
} = Astro.props;

const newsletterCta = (await getEntry('copy', 'home'))?.data.newsletterCta ?? 'Get the newsletter';
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;

// schema.org structured data, assembled from the single config source.
// One Bakery entity (same @id) on the home page and /visit.
const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: siteConfig.address.street,
  addressLocality: siteConfig.address.city,
  addressRegion: siteConfig.address.state,
  postalCode: siteConfig.address.zip,
  addressCountry: 'US',
};
const dayMap: Record<string, string[]> = {
  'Tuesday – Friday': ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
  'Saturday – Sunday': ['Saturday', 'Sunday'],
};
const to24 = (t: string) => {
  const m = t.match(/(\d+):(\d+)\s*(AM|PM)/i);
  if (!m) return undefined;
  let h = parseInt(m[1], 10);
  const min = m[2];
  if (/pm/i.test(m[3]) && h !== 12) h += 12;
  if (/am/i.test(m[3]) && h === 12) h = 0;
  return `${String(h).padStart(2, '0')}:${min}`;
};
const openingHours = siteConfig.hours
  .filter((h) => h.close && dayMap[h.days])
  .map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: dayMap[h.days].map((d) => `https://schema.org/${d}`),
    opens: to24(h.open),
    closes: to24(h.close),
  }));

// siteConfig.phone is empty while settings.json holds the placeholder, so the
// placeholder never reaches structured data; a real number flows in on its own.
const telephone = siteConfig.phone || undefined;

const jsonLd =
  schema === 'bakery' || schema === 'localbusiness'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Bakery',
        '@id': `${SITE_URL}/#bakery`,
        name: siteConfig.name,
        description: siteConfig.tagline,
        url: SITE_URL,
        telephone,
        email: siteConfig.email,
        image: ogImage,
        priceRange: '$$',
        address: postalAddress,
        openingHoursSpecification: openingHours,
        hasMenu: new URL('/menu/', SITE_URL).href,
        sameAs: [siteConfig.links.instagram],
      }
    : null;
---

<html
  lang="en"
  class={[
    'sys-slab',
    features.imageTone && 'img-tone',
    features.sketchyLinks && 'links-sketch',
  ].filter(Boolean).join(' ')}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/owners-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/owners-narrow-700.woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FBF5D4" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicons + app icons (generated from face.svg) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: four self-hosted Owners woff2 files (src/styles/fonts.css, public/fonts). -->

    <!-- schema.org structured data (home and visit: Bakery).
         Escape `<` so a value containing </script> can't break out. -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} is:inline />}

    {/* Pre-paint motion classes: set on <html> before first paint so reveal/
        hero start hidden only when motion will actually run (no FOUC, no
        stuck-hidden content under reduced-motion or when a flag is off). */}
    <script is:inline define:vars={{ flags: features }}>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          h.classList.add('reduced-motion');
          return;
        }
        h.classList.add('motion');
        if (flags.reveal) h.classList.add('fx-reveal');
      })();
    </script>

    <!-- Critical nav/hero CSS, inlined to protect first paint. -->
    <style is:inline>
      :root {
        --nav-h: 72px;
      }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 10000;
        background: var(--burgundy, #A10017);
        color: var(--butter, #FBF5D4);
        padding: 0.6rem 1rem;
        border-radius: 0;
        transition: top 160ms ease;
      }
      .skip-link:focus {
        top: 1rem;
      }
      .site-nav {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 1000;
        height: calc(var(--nav-h) + env(safe-area-inset-top, 0px));
        padding-top: env(safe-area-inset-top, 0px);
        display: flex;
        align-items: center;
      }
      @media (max-width: 768px) {
        .site-nav { --nav-h: 56px; }
      }
      .site-nav[data-transparent='true']:not([data-scrolled='true']) {
        background: transparent;
      }
      .site-nav[data-scrolled='true'],
      .site-nav:not([data-transparent='true']) {
        background: color-mix(in srgb, var(--butter, #FBF5D4) 78%, transparent);
        -webkit-backdrop-filter: saturate(140%) blur(12px);
        backdrop-filter: saturate(140%) blur(12px);
        box-shadow: 0 1px 0 color-mix(in srgb, var(--ink, #1D1D1B) 8%, transparent);
      }
      /* Reserve nav height on non-hero pages so content isn't hidden. */
      body:not([data-hero='true']) {
        padding-top: calc(var(--nav-h) + env(safe-area-inset-top, 0px));
      }
    </style>
  </head>

  <body data-hero={transparentNav ? 'true' : 'false'} class={features.mobileCtaBar ? 'has-cta-bar' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav transparent={transparentNav} />
    <main id="main">
      <slot />
    </main>
    <Footer newsletter={footerNewsletter} />

    {features.mobileCtaBar && (
      <div class="mobile-cta-bar" data-cta-bar>
        <a class="btn mobile-cta-link" href="#newsletter">{newsletterCta}</a>
      </div>
    )}

    <script>
      import '../scripts/motion.ts';
      import '../scripts/forms.ts';
    </script>
  </body>
</html>
