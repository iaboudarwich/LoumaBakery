---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { features as f } from '../config/features';

// The Louma Initiative (was /mission; /mission 301-redirects here). No photos,
// by the owner's choice. Every word comes from copy.json ("initiative"; CMS:
// Page text).
const c = (await getEntry('copy', 'initiative'))!.data;
const sections = c.sections ?? [];
const reveal = f.reveal ? 'reveal' : undefined;
---

<BaseLayout title={c.title} description={describe(c.intro)}>
  <header class="page-intro">
    <div class="container">
      <h1 class="display">{noOrphan(c.title ?? '')}</h1>
      <div class="intro" data-anim={reveal}>
        {c.intro.map((p) => <p class="lead">{p}</p>)}
      </div>
    </div>
  </header>

  {sections.length > 0 && (
    <section class="section">
      <div class="container">
        {sections.map((s) => (
          <div class="grid-12 text-row" data-anim={reveal}>
            <div class="text-row-title"><h2 class="h2">{s.title}</h2></div>
            <div class="text-row-body">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .intro { margin-top: var(--block-gap); max-width: 34em; }
  .intro .lead { max-width: none; }
</style>
