---
// The single-stroke baguette (src/assets/brand/baguette-stroke.svg), drawn
// like a pen on a loop: draw, hold, erase along the same line, pause, repeat.
// Only the home hero uses it; every other baguette is the filled master.
import strokeRaw from '../assets/brand/baguette-stroke.svg?raw';

/**
 * Pure CSS: one @keyframes on stroke-dashoffset (pathLength="1"), so the
 * timing lives in one place. An IntersectionObserver pauses the loop while
 * the drawing is off screen. With reduced motion, motion off (no html.motion)
 * or `animate={false}` the baguette is simply there, complete and static.
 * Decorative: aria-hidden.
 */
interface Props {
  /** Rendered width in px (height follows the viewBox). */
  size?: number;
  /** A colour token name from tokens.css (red, burgundy, ...). */
  color?: string;
  animate?: boolean;
  class?: string;
}
const { size = 140, color = 'red', animate = true, class: className } = Astro.props;

const viewBox = (strokeRaw.match(/viewBox="([^"]*)"/) || [])[1] ?? '0 0 466 165';
const d = (strokeRaw.match(/\sd="([^"]*)"/) || [])[1] ?? '';
const strokeWidth = (strokeRaw.match(/stroke-width="([^"]*)"/) || [])[1] ?? '12';
const [, , vw, vh] = viewBox.split(/\s+/).map(Number);
---

<svg
  class:list={['pen-draw', className]}
  viewBox={viewBox}
  width={size}
  height={Math.round((size * vh) / vw)}
  aria-hidden="true"
  focusable="false"
  style={`color: var(--${color})`}
  data-pen={animate ? 'loop' : undefined}
>
  <path d={d} pathLength="1" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
</svg>

<style>
  .pen-draw { display: block; height: auto; overflow: visible; }

  /* The loop, 4.9s in all: draw 1.8s (ease-in-out), hold 1.2s, erase 1.4s
     from the start point forward (the offset keeps moving the same way), pause
     0.5s. Dash 1, gap 1.1 on a path of length 1: an offset of 1.05 shows
     nothing, 0 shows the whole line, -1.05 shows nothing again and is the same
     phase as 1.05, so the jump back to the start is invisible. The 0.05 margin
     keeps the round caps of a zero-length dash off the start point. */
  @keyframes pen-loop {
    0%      { stroke-dashoffset: 1.05; animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1); }
    36.735% { stroke-dashoffset: 0; animation-timing-function: linear; }
    61.224% { stroke-dashoffset: 0; animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1); }
    89.796% { stroke-dashoffset: -1.05; }
    100%    { stroke-dashoffset: -1.05; }
  }
  :global(html.motion) .pen-draw[data-pen='loop'] path {
    stroke-dasharray: 1 1.1;
    animation: pen-loop 4.9s infinite;
  }
  :global(html.motion) .pen-draw[data-pen='loop'].is-offscreen path { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.motion) .pen-draw[data-pen='loop'] path { animation: none; stroke-dasharray: none; }
  }
</style>

<script>
  // Pause the loop while the drawing is off screen.
  const pens = document.querySelectorAll<SVGSVGElement>('.pen-draw[data-pen="loop"]');
  if (pens.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.target.classList.toggle('is-offscreen', !e.isIntersecting);
    });
    pens.forEach((p) => io.observe(p));
  }
</script>
