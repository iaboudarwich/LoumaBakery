---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { features as f } from '../config/features';
import { noOrphan } from '../lib/typography';

// Words: copy.json ("menu"); categories, items and their notes: menu.json
// (CMS: "Menu"). No prices, photos or drawings, by the owner's choice. One
// calm stacked column, like a printed menu.
const c = (await getEntry('copy', 'menu'))!.data;
const menu = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);
const reveal = f.reveal ? 'reveal' : undefined;
---

<BaseLayout title={c.title} description={describe(c.intro)}>
  <header class="page-intro">
    <div class="container">
      <h1 class="display">{noOrphan(c.title ?? '')}</h1>
      <div class="menu-intro" data-anim={reveal}>
        {c.intro.map((p) => <p class="lead">{p}</p>)}
      </div>
      {/* Category links: one plain row that wraps; each jumps to its section. */}
      <nav class="menu-jump" aria-label="Menu categories">
        <ul role="list">
          {menu.map((cat) => <li><a href={`#menu-${cat.id}`}>{cat.data.title}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>

  <div class="container menu-body">
    {menu.map((cat) => (
      <section class="menu-cat" id={`menu-${cat.id}`} aria-labelledby={`h-${cat.id}`}>
        <h2 class="h2" id={`h-${cat.id}`} data-anim={reveal}>{cat.data.title}</h2>
        <ul class="items" role="list">
          {cat.data.items.map((item) => (
            <li class="item">
              <span class="item-name">{item.name}</span>
              {item.note && <span class="item-note">{item.note}</span>}
            </li>
          ))}
        </ul>
        {cat.data.notes.map((n) => <p class="cat-note">{n}</p>)}
      </section>
    ))}

    {c.allergenNote && <p class="allergen">{c.allergenNote}</p>}
  </div>
</BaseLayout>

<style>
  .menu-intro { margin-top: var(--block-gap); max-width: 34em; }
  .menu-intro .lead { max-width: none; }

  /* Category links under the intro: not sticky, wraps on phones. */
  .menu-jump { margin-top: var(--block-gap); }
  .menu-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
  }
  .menu-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: var(--burgundy);
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* One column, about 40em, left-aligned with the intro. Categories sit a
     little closer than page sections: 3/4 of --section-y. */
  .menu-body {
    --menu-gap: calc(var(--section-y) * 0.75);
    padding-block: calc(var(--section-y) / 2) var(--section-y);
  }
  .menu-cat {
    max-width: 40em;
    /* An anchor jump lands the heading one block-gap under the header. */
    scroll-margin-top: calc(var(--nav-h) + env(safe-area-inset-top, 0px) + var(--block-gap));
  }
  .menu-cat + .menu-cat { margin-top: var(--menu-gap); }
  .menu-cat .h2 { margin-bottom: var(--space-5); }

  /* Items: one per line, Owners 400 at --fs-item (19-20px), burgundy. A note
     sits right under its name, small, burgundy at 80% (5.6:1 on butter). */
  .items { margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .item-name,
  .item-note { display: block; }
  .item-name {
    font-size: var(--fs-item);
    line-height: 1.4;
    color: var(--burgundy);
  }
  .item-note {
    margin-top: 2px;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: color-mix(in srgb, var(--burgundy) 80%, var(--butter));
  }
  .cat-note {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--burgundy);
  }
  .items + .cat-note { margin-top: var(--space-5); }
  .cat-note + .cat-note { margin-top: var(--space-2); }

  .allergen {
    margin-top: var(--menu-gap);
    max-width: 40em;
    font-size: var(--fs-small);
    color: var(--burgundy);
  }
</style>
