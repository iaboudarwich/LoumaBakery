---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { siteConfig } from '../config/site';
import { features as f } from '../config/features';
import MapDrawing from '../assets/brand/map-hand-drawn.svg';

// Contact page (route stays /visit). Title from copy.json ("visit"); address,
// hours, emails, Instagram and TikTok from settings.json.
const c = (await getEntry('copy', 'visit'))!.data;
const { address, hours, email, ordersEmail, directionsUrl } = siteConfig;
const { instagram, instagramHandle, tiktok, tiktokHandle } = siteConfig.links;
const reveal = f.reveal ? 'reveal' : undefined;
---

<BaseLayout title={c.title} schema="localbusiness" description={describe([c.title, `${address.street}, ${address.city}, ${address.state} ${address.zip}.`, ...hours.map((h) => `${h.days}: ${h.close ? `${h.open} to ${h.close}` : h.open}.`)])}>
  <header class="page-intro">
    <div class="container">
      <h1 class="display">{noOrphan(c.title ?? '')}</h1>
    </div>
  </header>

  {/* Burgundy block: the details left, the owner's hand-drawn map right (map
      first on narrow screens). Butter on burgundy throughout. */}
  <section class="section block--burgundy contact-block">
    <div class="container grid-12 contact-grid" data-anim={reveal}>
      <div class="contact-info" style="--span: 5">
        <div class="info-block">
          <h2 class="info-label label">Address</h2>
          <address class="contact-address">{address.street}<br />{address.city}, {address.state} {address.zip}</address>
        </div>
        <div class="info-block">
          <h2 class="info-label label">Hours</h2>
          <ul class="hours-grid" role="list">
            {hours.map((h) => (
              <li>
                <span>{h.days}</span>
                <span>{h.close ? `${h.open}–${h.close}` : h.open}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="info-block">
          <h2 class="info-label label">Contact</h2>
          <ul class="contact-list" role="list">
            <li><a href={`mailto:${email}`}>{email}</a></li>
            <li><a href={`mailto:${ordersEmail}`}>{ordersEmail}</a> for larger orders</li>
            <li><a href={instagram} target="_blank" rel="noopener" aria-label={`${instagramHandle} on Instagram`}>{instagramHandle}</a></li>
            {tiktok && <li><a href={tiktok} target="_blank" rel="noopener" aria-label={`${tiktokHandle || 'TikTok'} on TikTok`}>{tiktokHandle || 'TikTok'}</a></li>}
            <li><a href={directionsUrl} target="_blank" rel="noopener">Get directions</a></li>
          </ul>
        </div>
      </div>
      <div class="contact-map" style="--start: 7; --span: 6">
        <MapDrawing class="map-drawing" role="img" aria-label="Hand-drawn map of Louma Bakery at Wilshire Blvd and Centinela Ave" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { align-items: start; }
  .info-block + .info-block { margin-top: var(--block-gap); }
  .info-label { color: var(--butter); margin-bottom: var(--space-2); }
  .contact-address {
    font-style: normal;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    letter-spacing: var(--display-track);
    font-size: var(--fs-h2);
    line-height: 1.1;
  }
  .contact-list { margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .contact-list a {
    color: var(--butter);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .contact-map :global(.map-drawing) {
    display: block;
    width: 100%;
    height: auto;
    color: var(--butter);
  }
  /* Narrow screens: the map comes first. */
  @media (max-width: 47.99rem) {
    .contact-map { order: -1; }
  }
</style>
