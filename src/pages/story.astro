---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { features as f } from '../config/features';
import Sketch from '../components/Sketch.astro';

const c = (await getEntry('copy', 'story'))!.data;
// The letter and the sections live in src/data/story.json (CMS: "Our Story").
const { letter, sections } = (await getEntry('story', 'story'))!.data;
---

<BaseLayout title={c.title}>
  <header class="page-head story-head">
    <div class="container">
      <h1>{noOrphan(c.title ?? '')}</h1>
      <Sketch name="toast" width={92} height={107} class="head-toast" color="var(--burgundy)" draw={f.scrollDraw} />
    </div>
  </header>

  {/* The letter. The signature is text for now; a signature image comes later. */}
  <section class="story-intro" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container narrow">
      {letter.paragraphs.map((p) => <p class="story-p">{p}</p>)}
      <p class="story-p story-signature">{letter.signature}</p>
    </div>
  </section>

  {sections.map((s) => (
    <section class="story-section" data-anim={f.reveal ? 'reveal' : undefined}>
      <div class="container narrow">
        <h2>{s.title}</h2>
        {s.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .narrow { max-width: 720px; }
  .story-head { position: relative; overflow: hidden; }
  .story-head .container { position: relative; }
  /* :global: the class lands on the Sketch CHILD component's svg, which a
     page-scoped selector cannot reach. */
  .story-head :global(.head-toast) {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0;
    width: clamp(64px, 7vw, 92px);
    height: auto;
  }
  @media (max-width: 680px) {
    .story-head :global(.head-toast) { position: static; margin-top: var(--space-4); width: 72px; }
  }
  .story-intro { padding-block: var(--space-7); }
  .story-p { font-size: clamp(18px, 1.6vw, 21px); color: var(--body); }
  .story-p + .story-p { margin-top: var(--space-4); }

  .story-section { padding-block: var(--space-6); }
  .story-section h2 { margin-bottom: var(--space-3); }
</style>
