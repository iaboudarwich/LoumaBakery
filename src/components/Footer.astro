---
import { getEntry } from 'astro:content';
import { siteConfig } from '../config/site';
import { features } from '../config/features';
import { hoursGroups } from '../lib/hours';
import { Wordmark, WORDMARK_ART } from '../lib/brand';
import Face from '../assets/brand/face.svg';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  /** Show the footer newsletter. Pages with their own signup (home) pass false. */
  newsletter?: boolean;
  /** The footer's colour, the inverse of the page's: butter on the home
      page, burgundy everywhere else. */
  tone?: 'burgundy' | 'butter';
}
// The signup also needs features.newsletter on (off for now).
const newsletter = (Astro.props.newsletter ?? true) && features.newsletter;
const { tone = 'burgundy' } = Astro.props;

const { address, links, footer } = siteConfig;
const year = new Date().getFullYear();
const home = newsletter ? (await getEntry('copy', 'home'))?.data : undefined;
const hours = hoursGroups();
---

<footer class:list={['site-foot', `surface-${tone}`]}>
  <div class="container">
    <!-- Newsletter: on every page's footer except those with their own signup. -->
    {newsletter && (
      <div class="foot-newsletter" id="newsletter">
        <div class="foot-news">
          {home?.newsletterTitle && <p class="foot-news-h">{home.newsletterTitle}</p>}
          {home?.newsletterBody && <p class="foot-news-body">{home.newsletterBody}</p>}
          <NewsletterForm variant="footer" />
        </div>
      </div>
    )}

    <div class="foot-cols">
      <!-- Brand: the wordmark over the face, static. -->
      <div class="foot-brand">
        <Wordmark class="foot-wordmark" viewBox={WORDMARK_ART} width={192} height={71} aria-label={siteConfig.name} />
        <Face class="foot-face" width={192} height={178} aria-hidden="true" />
      </div>

      <!-- Visit: the address, then each hours group, from settings.json. -->
      <div class="foot-col">
        <h2 class="foot-h">Visit</h2>
        <address class="foot-groups">
          <p>{address.street},<br />{address.city}, {address.state} {address.zip}</p>
          {hours.map((g) => <p>{g.lines.map((l, i) => (i ? <><br />{l}</> : l))}</p>)}
        </address>
      </div>

      <!-- Say hi: its links (siteConfig.footer.sayHi), then Instagram and TikTok. -->
      <div class="foot-col">
        <h2 class="foot-h">Say hi</h2>
        <div class="foot-groups">
          {footer.sayHi.length > 0 && (
            <ul class="foot-list" role="list">
              {footer.sayHi.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          )}
          <ul class="foot-social" role="list">
            <li>
              <a class="foot-icon icon-btn" href={links.instagram} target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                  <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
                  <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                  <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" />
                </svg>
              </a>
            </li>
            {links.tiktok && (
              <li>
                <a class="foot-icon icon-btn" href={links.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
                  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
                  </svg>
                </a>
              </li>
            )}
          </ul>
        </div>
      </div>

      <!-- More: Contact Us and Large Order Inquiries (siteConfig.footer.more). -->
      <div class="foot-col">
        <h2 class="foot-h">More</h2>
        <ul class="foot-list" role="list">
          {footer.more.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <p class="foot-base">©{year} {siteConfig.name}.</p>
  </div>
</footer>

<style>
  /* The footer is the page's inverse colour (.surface-butter on the home
     page, .surface-burgundy elsewhere): text, icons, drawings and the
     hairline all take currentColor. Four columns: the brand, Visit, Say hi,
     More; then a hairline and the copyright, centred. */
  .site-foot {
    font-size: var(--fs-body);
    line-height: 1.2;
    padding-block: calc(var(--section-y) * 0.85) var(--space-6);
  }
  /* A butter gap above a burgundy footer, so it never runs into a
     burgundy block at the end of a page (the Contact page). */
  .site-foot.surface-burgundy { margin-top: var(--space-8); }
  .site-foot p { max-width: none; }
  .site-foot p + p { margin-top: 0; }

  .foot-newsletter {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid currentColor;
  }
  .foot-news { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .foot-news-h { font-weight: 500; font-size: var(--fs-lead); }
  /* Newsletter form/input styling lives in NewsletterForm.astro (scoped to where it renders). */

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-7) var(--block-gap);
    align-items: start;
  }

  /* The marks are Astro SVG components rendered here: :global reaches their
     root <svg>. Static (no draw, no reveal). */
  .foot-brand { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); }
  .foot-brand :global(.foot-wordmark),
  .foot-brand :global(.foot-face) { display: block; width: clamp(112px, 13.3vw, 192px); height: auto; color: currentColor; }

  .foot-h {
    font-size: var(--fs-body);
    line-height: 1.2;
    color: inherit;
    margin-bottom: var(--space-6);
  }
  /* Lines inside a group sit tight; the groups are --space-5 apart. */
  .foot-groups { display: grid; gap: var(--space-5); justify-items: start; font-style: normal; }
  .foot-list,
  .foot-social { margin: 0; padding: 0; }
  .foot-list { display: grid; }

  /* Links: no underline at rest; hover and focus draw the 2px peach line
     (global.css), the text keeps its colour. Every footer link at least
     24px tall (WCAG 2.5.8), 44px on touch. */
  .foot-list a { display: inline-block; padding-block: 2px; text-decoration-line: none; }
  @media (pointer: coarse) {
    .foot-list a { display: inline-flex; align-items: center; min-height: 44px; }
  }
  @media (hover: hover) and (pointer: fine) {
    .foot-list a:hover { text-decoration-line: underline; }
  }
  .foot-list a:focus-visible { text-decoration-line: underline; }

  /* Instagram and TikTok: 24px icons in 44px links (.icon-btn draws the
     peach hover and focus line). */
  .foot-social { display: flex; gap: var(--space-2); margin-inline-start: -10px; }
  .foot-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: inherit;
  }
  .foot-icon svg { display: block; width: 24px; height: 24px; }

  .foot-base {
    margin-top: var(--section-y);
    padding-top: var(--space-5);
    border-top: 1px solid currentColor;
    font-size: var(--fs-fine);
    text-transform: uppercase;
    text-align: center;
  }

  /* Phones: one column; the wordmark and the face side by side on top. */
  @media (max-width: 47.99rem) {
    .foot-cols { grid-template-columns: 1fr; }
    .foot-brand { flex-direction: row; align-items: center; }
  }
</style>
