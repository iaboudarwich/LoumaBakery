---
/**
 * One of the designer's drawings, inlined so it takes its colour from
 * currentColor. `name` is a file in src/assets/brand/doodles/ (with or without
 * ".svg"); the baguette and face marks in src/assets/brand/ resolve
 * too, so the same component and the same animation serve every drawing.
 *
 * `animate` attaches the one-shot doodleDraw effect (src/scripts/motion.ts):
 * filled outlines (every master on the board) reveal left to right with a
 * clip-path; stroked art draws on via pathLength. Gate it with the feature
 * flag at the call site. With motion off or reduced motion the drawing is
 * simply there, fully visible.
 *
 * Decorative by default (aria-hidden). Pass `label` when the drawing carries
 * meaning on its own.
 */
const doodles = import.meta.glob<string>('../assets/brand/doodles/*.svg', { query: '?raw', import: 'default', eager: true });
const marks = import.meta.glob<string>('../assets/brand/{baguette,face}.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  name: string;
  /** Rendered width in px (height follows the drawing's viewBox). */
  size?: number;
  /** A colour token name from tokens.css (red, burgundy, butter, ink, ...). */
  color?: string;
  animate?: boolean;
  label?: string;
  class?: string;
  /** A fixed-height box (`size` tall), drawing bottom-left aligned, so a row
      of different drawings shares one baseline (pillars, headings). Wide
      drawings get up to twice the width. */
  box?: boolean;
}
const { name, size = 64, color = 'red', animate = false, label, class: className, box = false } = Astro.props;

const file = name.replace(/\.svg$/, '');
const raw = doodles[`../assets/brand/doodles/${file}.svg`] ?? marks[`../assets/brand/${file}.svg`];
if (!raw) throw new Error(`Doodle: no drawing named "${name}" in src/assets/brand/doodles/ or the brand marks.`);

const viewBox = (raw.match(/viewBox="([^"]*)"/) || [])[1] ?? '0 0 100 100';
const [, , vw, vh] = viewBox.split(/[\s,]+/).map(Number);
const height = Math.round((size * vh) / vw);
const boxW = Math.min(Math.round((size * vw) / vh), size * 2);
const w = box ? boxW : size;
let inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');

// Strokes or filled outlines? Stroked art has a visible stroke and no fill.
const stroked = /stroke="(?!none)[^"]+"/.test(raw) && /fill="none"/.test(raw);
const mode = stroked ? 'stroke' : 'fill';
if (animate && stroked) inner = inner.replace(/<(path|line|polyline|circle|ellipse|rect)\b/g, '<$1 pathLength="1"');
---

<span class={['doodle', box && 'doodle--box', className].filter(Boolean).join(' ')} style={`--doodle-w: ${w}px; --doodle-h: ${size}px`}>
  <svg
    viewBox={viewBox}
    width={w}
    height={box ? size : height}
    preserveAspectRatio={box ? 'xMinYMax meet' : undefined}
    fill="currentColor"
    style={`color: var(--${color})`}
    role={label ? 'img' : undefined}
    aria-label={label || undefined}
    aria-hidden={label ? undefined : 'true'}
    focusable="false"
    data-doodle={animate ? mode : undefined}
    set:html={inner}
  />
</span>

<style>
  .doodle { display: inline-block; width: var(--doodle-w); max-width: 100%; line-height: 0; }
  .doodle svg { display: block; width: 100%; height: auto; overflow: visible; }
  .doodle--box { height: var(--doodle-h); }
  .doodle--box svg { height: 100%; }
</style>
