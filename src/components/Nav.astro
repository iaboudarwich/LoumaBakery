---
import { siteConfig } from '../config/site';
import SiteMenu from './SiteMenu.astro';
// The wordmark is cropped to its art (WORDMARK_ART) so the drawing fills its
// box; the file itself keeps its 374x240 role box.
import { Wordmark, WORDMARK_ART } from '../lib/brand';

interface Props {
  /** The bar's colour: burgundy with a butter wordmark (home), or butter
      with a burgundy wordmark (every other page). */
  tone?: 'burgundy' | 'butter';
}
const { tone = 'butter' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

{/* The header: the menu button left, the wordmark centred, no links. Tall at
    the top of the page; once the page scrolls, a compact bar fixed to the
    top (html.head-compact, set by the script below). The block keeps its
    tall height in the page, so nothing below it moves. */}
<header class:list={['site-head', `surface-${tone}`]}>
  <div class="head-bar">
    <div class="container head-inner">
      <button type="button" class="nav-toggle icon-btn" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <a href="/" class="brand" aria-label={`${siteConfig.name} home`}>
        <Wordmark class="brand-mark" viewBox={WORDMARK_ART} aria-hidden="true" />
      </a>
    </div>
  </div>
</header>

<SiteMenu currentPath={path} />

<style>
  .site-head {
    position: relative;
    z-index: 1000;
    height: calc(var(--head-h) + env(safe-area-inset-top, 0px));
  }
  .head-bar {
    height: 100%;
    padding-top: env(safe-area-inset-top, 0px);
    background: inherit;
    color: inherit;
  }
  /* With JS the bar is fixed to the top and shrinks once the page scrolls;
     without JS it is the tall block, in the page. */
  :global(html.js) .head-bar {
    position: fixed;
    inset: 0 0 auto;
    height: calc(var(--head-h) + env(safe-area-inset-top, 0px));
    transition: height var(--dur) var(--ease-out);
  }
  :global(html.head-compact) .head-bar { height: calc(var(--nav-h) + env(safe-area-inset-top, 0px)); }

  .head-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  /* The wordmark, centred; 160px wide at 1440, smaller in the compact bar. */
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* tap target */
    color: inherit;
  }
  .brand :global(.brand-mark) {
    display: block;
    width: var(--brand-w);
    height: auto;
    color: inherit;
    transition: width var(--dur) var(--ease-out);
  }
  :global(html.head-compact) .brand :global(.brand-mark) { width: var(--brand-w-compact); }

  /* The menu button: three lines, left, level with the wordmark's middle. */
  .nav-toggle {
    position: absolute;
    inset-inline-start: max(var(--gutter), env(safe-area-inset-left));
    top: 50%;
    translate: -10px -50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    background: transparent;
    color: inherit;
  }
  .nav-toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: currentColor;
  }
</style>

<script>
  // The compact bar: html.head-compact once the page has scrolled past the
  // top. One passive scroll listener, read in a frame.
  const root = document.documentElement;
  let queued = false;
  const update = () => {
    queued = false;
    root.classList.toggle('head-compact', window.scrollY > 8);
  };
  update();
  window.addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(update); }
  }, { passive: true });
</script>
