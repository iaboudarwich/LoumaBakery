---
import { siteConfig } from '../config/site';

/**
 * Single newsletter signup form (Netlify Forms). Used by the homepage and the
 * global footer. Variant only changes class hooks + the input id (so two can
 * coexist on one page without an id clash). Copy comes from siteConfig.forms.
 */
interface Props {
  variant?: 'page' | 'footer';
}
const { variant = 'page' } = Astro.props;
const id = variant === 'footer' ? 'foot-news-email' : 'news-email';
const rowClass = variant === 'footer' ? 'foot-news-row' : 'news-row';
const formClass = variant === 'footer' ? 'foot-news-form' : 'news-form';
---

<form
  name="newsletter"
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  class={formClass}
>
  <input type="hidden" name="form-name" value="newsletter" />
  {/* Messages live in hidden elements, not form attributes: Netlify rewrites the
      <form> tag at deploy and mangles apostrophes in its attribute values. */}
  <span hidden data-form-msg="success">{siteConfig.forms.newsletterSuccess}</span>
  <span hidden data-form-msg="error">{siteConfig.forms.error}</span>
  <p class="visually-hidden" aria-hidden="true"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  <label class="visually-hidden" for={id}>Email address</label>
  <div class={rowClass}>
    <input id={id} type="email" name="email" required placeholder="you@email.com" autocomplete="email" inputmode="email" />
    <button type="submit" class="btn btn-coral">Notify me</button>
  </div>
</form>

<style>
  /* Styles live here (not the parent) because the input is rendered by this
     component — Astro's scoped styles don't reach a child's elements. Both
     variants sit on dark panels, so the dark fill works for both. */
  .news-form { max-width: 460px; }
  .foot-news-form { flex: 1; min-width: min(280px, 100%); max-width: 460px; }

  .news-row,
  .foot-news-row {
    display: flex;
    gap: var(--space-2);
  }
  .news-row input,
  .foot-news-row input {
    flex: 1;
    min-height: 48px;
    padding: 0 0.9rem;
    font-size: clamp(16px, calc(16px + (100vw - 1920px) * 0.003125), 18px); /* iOS zooms on focus below 16px */
    border: 1px solid color-mix(in srgb, var(--butter) 30%, transparent);
    border-radius: 0;
    background: var(--ink); /* opaque dark fill so the light text reads */
    color: var(--butter);
  }
  .news-row input::placeholder,
  .foot-news-row input::placeholder {
    color: color-mix(in srgb, var(--butter) 60%, var(--ink)); /* 6.3:1 on the ink fill */
  }
  @media (max-width: 520px) {
    .news-row,
    .foot-news-row { flex-direction: column; }
  }
  /* On the burgundy newsletter card (home) the filled burgundy CTA vanished into
     the card, so there it inverts: butter fill, burgundy text (7.56:1). Same
     size and position. The footer variant sits on ink and keeps the default. */
  :global(html.sys-slab) .news-form .btn-coral {
    background: var(--butter);
    border-color: var(--butter);
    color: var(--burgundy);
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html.sys-slab) .news-form .btn-coral:hover {
      background: var(--white);
      border-color: var(--white);
      color: var(--burgundy);
    }
  }
</style>
