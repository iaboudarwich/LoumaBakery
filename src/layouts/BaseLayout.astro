---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { siteConfig, SITE_URL } from '../config/site';
import { features } from '../config/features';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// Self-hosted Owners faces (font-display: swap), served from public/fonts.
import '../styles/fonts.css';

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter image path (absolute or root-relative). */
  image?: string;
  /** schema.org / OG type. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search indexes (internal pages). */
  noindex?: boolean;
  /** schema.org structured data (Bakery on home and visit), or none. Both values emit the same entity. */
  schema?: 'bakery' | 'localbusiness';
  /** Show the footer newsletter. Pages with their own signup (home) pass false. */
  footerNewsletter?: boolean;
  /** The page colour. "burgundy" (home): a burgundy page and header with
      butter text, and a butter footer. "butter" (every other page): the
      reverse. */
  tone?: 'burgundy' | 'butter';
}

// The owner's tagline (copy.json "home") is the site-wide default title and
// description, and the Bakery description in structured data.
const ownerTagline = (await getEntry('copy', 'home'))?.data.tagline ?? siteConfig.name;

const {
  title,
  description = ownerTagline,
  image = '/og-default.jpg', // center crop of the hero frame, now src/assets/img/croissant-grid.jpg (Kayla shoot)
  ogType = 'website',
  noindex = false,
  schema,
  footerNewsletter = true,
  tone = 'butter',
} = Astro.props;
const inverse = tone === 'burgundy' ? 'butter' : 'burgundy';

const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${ownerTagline}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;

// schema.org structured data, assembled from the single config source.
// One Bakery entity (same @id) on the home page and /visit.
const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: siteConfig.address.street,
  addressLocality: siteConfig.address.city,
  addressRegion: siteConfig.address.state,
  postalCode: siteConfig.address.zip,
  addressCountry: 'US',
};
// "Tuesday – Sunday" -> Tuesday..Sunday; a single day maps to itself. Any
// label that isn't a day or a range of days is left out of structured data.
const WEEK = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const daysOf = (label: string): string[] => {
  const [from, to = from] = label.split(/\s*[–-]\s*/).map((d) => d.trim());
  const a = WEEK.indexOf(from), b = WEEK.indexOf(to);
  if (a < 0 || b < 0) return [];
  return a <= b ? WEEK.slice(a, b + 1) : [...WEEK.slice(a), ...WEEK.slice(0, b + 1)];
};
const to24 = (t: string) => {
  const m = t.match(/(\d+):(\d+)\s*(AM|PM)/i);
  if (!m) return undefined;
  let h = parseInt(m[1], 10);
  const min = m[2];
  if (/pm/i.test(m[3]) && h !== 12) h += 12;
  if (/am/i.test(m[3]) && h === 12) h = 0;
  return `${String(h).padStart(2, '0')}:${min}`;
};
const openingHours = siteConfig.hours
  .filter((h) => h.close && daysOf(h.days).length)
  .map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: daysOf(h.days).map((d) => `https://schema.org/${d}`),
    opens: to24(h.open),
    closes: to24(h.close),
  }));

const jsonLd =
  schema === 'bakery' || schema === 'localbusiness'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Bakery',
        '@id': `${SITE_URL}/#bakery`,
        name: siteConfig.name,
        description: ownerTagline,
        url: SITE_URL,
        email: siteConfig.email,
        image: ogImage,
        priceRange: '$$',
        address: postalAddress,
        openingHoursSpecification: openingHours,
        hasMenu: new URL('/menu/', SITE_URL).href,
        sameAs: [siteConfig.links.instagram, siteConfig.links.tiktok].filter(Boolean),
      }
    : null;
---

<html lang="en" class="sys-slab">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/owners-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/owners-narrow-700.woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={tone === 'burgundy' ? '#A10017' : '#FBF5D4'} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicons + app icons (generated from face.svg) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: three self-hosted Owners woff2 files (src/styles/fonts.css, public/fonts); the two above the fold on every page (Owners 400, Owners Narrow 700) are preloaded. -->

    <!-- schema.org structured data (home and visit: Bakery).
         Escape `<` so a value containing </script> can't break out. -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} is:inline />}

    {/* Pre-paint motion classes: set on <html> before first paint so reveals
        and doodles start hidden only when motion will actually run (no FOUC,
        no stuck-hidden content under reduced-motion or when a flag is off). */}
    <script is:inline define:vars={{ flags: features }}>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          h.classList.add('reduced-motion');
          return;
        }
        h.classList.add('motion');
        if (flags.reveal) h.classList.add('fx-reveal');
        if (flags.doodleDraw) h.classList.add('fx-doodle');
      })();
    </script>

    <!-- The skip link, inlined so it works before the stylesheet loads. -->
    <style is:inline>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: 0;
        z-index: 10000;
        translate: 0 -110%;
        background: var(--burgundy, #A10017);
        color: var(--butter, #FBF5D4);
        outline-color: var(--butter, #FBF5D4);
        padding: 0.6rem 1rem;
        border-radius: 0;
        transition: translate 160ms ease;
      }
      .skip-link:focus {
        translate: 0 1rem;
      }
    </style>
  </head>

  <body class={`surface-${tone}`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav tone={tone} />
    <main id="main">
      <slot />
    </main>
    <Footer newsletter={footerNewsletter} tone={inverse} />

    <script>
      import '../scripts/motion.ts';
      import '../scripts/forms.ts';
    </script>
  </body>
</html>
