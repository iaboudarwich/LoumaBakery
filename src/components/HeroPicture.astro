---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Home hero with art direction. Portrait phones get a dedicated 3:4 crop of
 * the hero photo (far more pixels per croissant than a tall slice of the
 * landscape frame); every other viewport gets the landscape photo with the
 * exact widths, formats, quality and sizes <Img> used before, so its output
 * is unchanged.
 */
interface Props {
  landscape: ImageMetadata;
  portrait?: ImageMetadata;
  quality: number;
  /** Motion hook placed on the <picture> (e.g. 'ken-burns'). */
  anim?: string;
}
const { landscape, portrait, quality, anim } = Astro.props;

// Read dimensions from the metadata clone so Astro doesn't ship the originals.
const dims = (m: ImageMetadata) => (m as ImageMetadata & { clone?: ImageMetadata }).clone ?? m;
const widthsFor = (m: ImageMetadata, candidates: number[]) => {
  const w = dims(m).width;
  return Array.from(new Set(candidates.filter((c) => c <= w).concat(w))).sort((a, b) => a - b);
};

const landscapeWidths = widthsFor(landscape, [400, 800, 1200, 1600]);
const landSizes = '100vw';
const [landAvif, landWebp, landFallback] = await Promise.all([
  getImage({ src: landscape, widths: landscapeWidths, sizes: landSizes, format: 'avif', quality }),
  getImage({ src: landscape, widths: landscapeWidths, sizes: landSizes, format: 'webp', quality }),
  getImage({ src: landscape, widths: landscapeWidths, sizes: landSizes, format: 'jpg', quality }),
]);

// Portrait crop: the tall hero box on a phone is ~1.25x the viewport width
// once cover-fitted, so size the candidates against that. Capped at 1200w:
// the next step (1500w) is ~173KB AVIF, over the 150KB mobile hero budget.
const PORTRAIT_MEDIA = '(max-width: 767px) and (orientation: portrait)';
const portSizes = '125vw';
const PORTRAIT_WIDTHS = [600, 900, 1200];
const portrait_ = portrait
  ? await (async () => {
      const widths = PORTRAIT_WIDTHS.filter((w) => w <= dims(portrait).width);
      const [avif, webp] = await Promise.all([
        getImage({ src: portrait, widths, sizes: portSizes, format: 'avif', quality }),
        getImage({ src: portrait, widths, sizes: portSizes, format: 'webp', quality }),
      ]);
      return { avif, webp };
    })()
  : undefined;
---

<picture class="limg hero-bg" data-anim={anim}>
  {portrait_ && <source media={PORTRAIT_MEDIA} srcset={portrait_.avif.srcSet.attribute} type="image/avif" sizes={portSizes} />}
  {portrait_ && <source media={PORTRAIT_MEDIA} srcset={portrait_.webp.srcSet.attribute} type="image/webp" sizes={portSizes} />}
  <source srcset={landAvif.srcSet.attribute} type="image/avif" sizes={landSizes} />
  <source srcset={landWebp.srcSet.attribute} type="image/webp" sizes={landSizes} />
  <img
    src={landFallback.src}
    srcset={landFallback.srcSet.attribute}
    alt=""
    sizes={landSizes}
    loading="eager"
    decoding="auto"
    fetchpriority="high"
    width={dims(landscape).width}
    height={dims(landscape).height}
    class="img-cover"
  />
</picture>
