---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { features as f } from '../config/features';
import { siteConfig } from '../config/site';

const c = (await getEntry('copy', 'catering'))!.data;
const steps = c.steps ?? [];
const tiers = c.tiers ?? [];
// Earliest selectable event date (build date); blocks past dates.
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout title="Catering" description={c.lede}>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{noOrphan(c.title ?? '')}</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
    </div>
  </header>

  {/* Process */}
  {steps.length > 0 && (
    <section class="process">
      <div class="container">
        <ol class="process-grid" data-anim={f.reveal ? 'reveal' : undefined} data-reveal-children>
          {steps.map((s) => (
            <li class="step">
              {/* Numbered markers removed by request; could return later as
                  small custom drawn-numeral images. */}
              <h2 class="step-title">{s.title}</h2>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {/* Tiers */}
  {tiers.length > 0 && (
    <section class="tiers cv-auto">
      <div class="container">
        <div class="sec-head"><p class="eyebrow">Options</p><h2>Pick a starting point</h2></div>
        <ul class="tiers-grid" role="list" data-anim={f.reveal ? 'reveal' : undefined} data-reveal-children>
          {tiers.map((t) => (
            <li class="tier">
              {t.note && <span class="tier-note mono">{t.note}</span>}
              <h3 class="tier-name">{t.name}</h3>
              <p class="tier-price mono">{t.price}</p>
              <ul class="tier-items" role="list">
                {t.items.map((it) => <li>{it}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Inquiry form */}
  <section class="inquiry cv-auto" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container narrow">
      <div class="sec-head">
        <p class="eyebrow">Start here</p><h2>Catering inquiry</h2>
        {c.body.map((para) => <p>{para}</p>)}
      </div>
      <form
        name="catering"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="form-grid"
        data-success={siteConfig.forms.cateringSuccess}
        data-error={siteConfig.forms.error}
      >
        <input type="hidden" name="form-name" value="catering" />
        <p class="visually-hidden" aria-hidden="true"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field"><label for="cat-name">Name</label><input id="cat-name" name="name" type="text" required autocomplete="name" /></div>
        <div class="field"><label for="cat-email">Email</label><input id="cat-email" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
        <div class="field"><label for="cat-date">Event date</label><input id="cat-date" name="event-date" type="date" min={today} required /></div>
        <div class="field"><label for="cat-head">Headcount</label><input id="cat-head" name="headcount" type="number" min="1" inputmode="numeric" required /></div>
        <div class="field field--full"><label for="cat-msg">Message</label><textarea id="cat-msg" name="message" required></textarea></div>
        <div class="field--full"><button type="submit" class="btn btn-primary">Send inquiry</button></div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 760px; }
  .process { padding-block: var(--space-8); }
  .process-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .step-title { margin-bottom: var(--space-2); font-size: clamp(26px, calc(26px + (100vw - 1920px) * 0.005469), 29.5px); }
  .step::before { content: ''; display: block; width: 40px; height: 2px; background: var(--clay); margin-bottom: var(--space-4); }

  .tiers { padding-block: var(--space-8) var(--space-9); background: var(--surface-1); }
  .tiers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .tier {
    position: relative;
    padding: var(--space-6);
    background: var(--surface-0);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .tier-note {
    position: absolute; top: -10px; left: var(--space-5);
    background: var(--coral); color: var(--ink);
    font-size: clamp(13px, calc(13px + (100vw - 1920px) * 0.002344), 14.5px); letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.25rem 0.6rem; border-radius: var(--radius-pill);
  }
  .tier-name { font-size: clamp(26px, calc(26px + (100vw - 1920px) * 0.005469), 29.5px); }
  .tier-price { color: var(--burgundy); font-size: clamp(18px, calc(18px + (100vw - 1920px) * 0.003906), 20.5px); margin: var(--space-2) 0 var(--space-4); }
  .tier-items { display: flex; flex-direction: column; gap: var(--space-2); color: var(--body); font-size: clamp(15px, calc(15px + (100vw - 1920px) * 0.003125), 17px); }
  .tier-items li { padding-left: 1.2em; position: relative; }
  .tier-items li::before { content: '·'; position: absolute; left: 0; color: var(--clay); }

  .inquiry { padding-block: var(--space-9); }
  .inquiry .sec-head > h2 + p { margin-top: var(--space-2); }

  @media (max-width: 820px) {
    .process-grid, .tiers-grid { grid-template-columns: 1fr; }
  }
</style>
