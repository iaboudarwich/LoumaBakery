---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { features as f } from '../config/features';
import { siteConfig } from '../config/site';

// Hidden for now: while features.careersPage is false the route belongs to the
// redirect in astro.config.mjs (so this never runs in a build); the guard
// covers anything that renders the page anyway.
if (!f.careersPage) return Astro.redirect('/', 301);

const c = (await getEntry('copy', 'careers'))!.data;
const roles = c.roles ?? [];
---

<BaseLayout title="Careers" description={describe([c.lede, ...c.body])}>
  <header class="page-intro">
    <div class="container">
      {c.eyebrow && <p class="label page-label">{c.eyebrow}</p>}
      <h1 class="display">{noOrphan(c.title ?? '')}</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
    </div>
  </header>

  {/* Intro */}
  <section class="section careers-intro" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container narrow">
      {c.body.map((p) => <p class="lead">{p}</p>)}
    </div>
  </section>

  {/* Roles */}
  {roles.length > 0 && (
    <section class="section block--white roles cv-auto">
      <div class="container">
        <div class="sec-head"><p class="label sec-label">Open roles</p><h2 class="h2">Where you'd fit</h2></div>
        <ul class="roles-list" role="list" data-anim={f.reveal ? 'reveal' : undefined} data-reveal-children>
          {roles.map((r) => (
            <li class="role">
              <div class="role-head">
                <h3 class="role-title">{r.title}</h3>
                {r.type && <span class="role-type mono">{r.type}</span>}
              </div>
              <p class="role-body">{r.body}</p>
              <a class="role-apply" href="#apply">Apply →</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Application form */}
  <section class="section apply cv-auto" id="apply" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container narrow">
      <div class="sec-head"><p class="label sec-label">Apply</p><h2 class="h2">Tell us about you</h2></div>
      <form
        name="careers"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="form-grid"
      >
        <input type="hidden" name="form-name" value="careers" />
        {/* Messages live in hidden elements, not form attributes: Netlify rewrites the
            <form> tag at deploy and mangles apostrophes in its attribute values. */}
        <span hidden data-form-msg="success">{siteConfig.forms.careersSuccess}</span>
        <span hidden data-form-msg="error">{siteConfig.forms.error}</span>
        <p class="visually-hidden" aria-hidden="true"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field"><label for="job-name">Name</label><input id="job-name" name="name" type="text" required autocomplete="name" /></div>
        <div class="field"><label for="job-email">Email</label><input id="job-email" name="email" type="email" required autocomplete="email" inputmode="email" /></div>
        <div class="field"><label for="job-phone">Phone</label><input id="job-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" /></div>
        <div class="field">
          <label for="job-role">Role</label>
          <select id="job-role" name="role" required>
            <option value="" disabled selected>Choose a role</option>
            {roles.map((r) => <option value={r.title}>{r.title}</option>)}
          </select>
        </div>
        <div class="field field--full"><label for="job-about">About you</label><textarea id="job-about" name="about" required></textarea></div>
        <div class="field--full"><button type="submit" class="btn btn-primary">Send application</button></div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  /* Global system (tokens.css): container, --section-y rhythm, --fs-* scale. */
  .page-label { color: var(--burgundy); margin-bottom: var(--space-5); }
  .sec-head { margin-bottom: var(--block-gap); }
  .sec-label { color: var(--burgundy); margin-bottom: var(--space-2); }
  .narrow { max-width: calc(var(--container) * 2 / 3); }
  .careers-intro .lead { max-width: 34em; }
  .roles-list { display: flex; flex-direction: column; gap: var(--space-4); }
  .role {
    padding: var(--block-gap);
    background: var(--butter);
    border: 1px solid var(--hairline-strong);
  }
  .role-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .role-title { font-size: var(--fs-lead); line-height: 1.2; color: var(--ink); }
  .role-type { color: var(--burgundy); font-size: var(--fs-small); letter-spacing: 0.06em; text-transform: uppercase; }
  .role-body { margin: var(--space-3) 0 var(--space-4); color: var(--body); }
  .role-apply { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; color: var(--burgundy); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    .role-apply:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  }
  .apply { scroll-margin-top: calc(var(--nav-h) + 24px); }
</style>
