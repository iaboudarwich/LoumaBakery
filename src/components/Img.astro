---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Responsive image wrapper. Emits AVIF + WebP via <picture>, with width/height
 * baked from the source (no layout shift). Below-the-fold by default (lazy);
 * pass `priority` for the LCP hero (eager + high fetch priority). Photos render
 * exactly as shot: no filter, no overlay, never animated.
 *
 * The layout class goes on the <picture> (which carries the aspect-ratio box);
 * the <img> always covers it.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  /** Inline style on the <picture>, e.g. grid placement (`--span: 5`). */
  style?: string;
  /** Encoder quality (1-100). Omit for the service default. */
  quality?: number;
}
const { src, alt, sizes = '100vw', widths, priority = false, class: className, style, quality } = Astro.props;

// Read dimensions from the metadata `clone`: touching `src.width` directly marks
// the full-size original as referenced, and Astro then copies it into dist even
// though no page links to it. getImage() already uses the clone internally.
const srcWidth = (src as ImageMetadata & { clone?: ImageMetadata }).clone?.width ?? src.width;
const candidate = widths ?? [400, 800, 1200, 1600];
const useWidths = Array.from(new Set(candidate.filter((w) => w <= srcWidth).concat(srcWidth))).sort(
  (a, b) => a - b,
);
const pictureAttributes: Record<string, unknown> = { class: `limg ${className ?? ''}`.trim() };
if (style) pictureAttributes.style = style;
---

<Picture
  src={src}
  formats={['avif', 'webp']}
  alt={alt}
  widths={useWidths}
  quality={quality}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'auto' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class="img-cover"
  pictureAttributes={pictureAttributes}
/>
