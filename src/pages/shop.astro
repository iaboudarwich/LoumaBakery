---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { features as f } from '../config/features';
import Img from '../components/Img.astro';
import Doodle from '../components/Doodle.astro';
import { Wordmark, WORDMARK_ART } from '../lib/brand';
import { resolveImage } from '../lib/images';

// Words: copy.json ("shop": the title, the "Coming soon" words and the
// button words). The intro line and the products, in the order shown:
// shop.json (CMS: "Shop"). A burgundy band (the palm, the title, the intro),
// then a grid of product cards. A product with a link gets a button that
// opens it in a new tab; without one, a "Coming soon" box that is not a
// control. The first photo loads eagerly: on phones it is in the first
// screen, under the band.
const c = (await getEntry('copy', 'shop'))!.data;
const shop = (await getEntry('shop', 'shop'))!.data;
const soon = c.status ?? '';
const cart = c.cart ?? '';
const products = shop.products.map((p) => ({ ...p, photo: p.image ? resolveImage(p.image) : undefined }));
const reveal = f.reveal ? 'reveal' : undefined;
const SIZES = '(max-width: 39.99rem) 100vw, (max-width: 63.99rem) 50vw, 343px';
---

<BaseLayout title={c.title} description={describe([shop.intro])}>
  <header class="page-band surface-burgundy shop-band">
    <div class="container shop-band-inner">
      <Doodle name="palm" size={122} color="butter" animate={f.doodleDraw} class="shop-palm" />
      <div class="shop-band-text">
        <h1 class="display">{noOrphan(c.title ?? '')}</h1>
        {shop.intro && <p>{shop.intro}</p>}
      </div>
    </div>
  </header>

  <section class="section shop-grid" aria-label="Products">
    <div class="container">
      <ul class="products" role="list" data-anim={reveal} data-reveal-children>
        {products.map((p, i) => (
          <li class="card">
            <div class:list={['tile', `tile--${p.kind === 'giftcard' ? 'giftcard' : p.fit}`]}>
              {p.kind === 'giftcard' ? (
                <div class="giftcard" aria-hidden="true">
                  <Wordmark class="giftcard-mark" viewBox={WORDMARK_ART} width={180} height={66} />
                  <span class="giftcard-label">Gift card</span>
                </div>
              ) : p.photo ? (
                <Img src={p.photo} alt={p.alt || p.name} class="tile-img" sizes={SIZES} widths={[480, 720, 960]} priority={i === 0} />
              ) : null}
            </div>
            <div class="card-head">
              <h2 class="card-name">{p.name}</h2>
              {p.price && <p class="card-price">{p.price}</p>}
            </div>
            {p.note && <p class="card-note">{p.note}</p>}
            {p.link
              ? cart && <a class="btn btn-primary card-action" href={p.link} target="_blank" rel="noopener">{cart}<span class="visually-hidden">: {p.name} (opens in a new tab)</span></a>
              : soon && <p class="btn-box card-action">{soon}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* The band: full-bleed burgundy, at least min(19.4vw, 280px) tall (280
     at 1440); the palm 170px tall at 1440; the palm and the title with the intro beside it, centred as
     a group. Phones: the palm above the text, centred. */
  .shop-band-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--block-gap) * 2);
    min-height: min(19.4vw, 280px);
    padding-block: var(--block-gap);
  }
  .shop-band-inner :global(.shop-palm) { flex: none; width: clamp(90px, 8.47vw, 122px); }
  .shop-band-text { display: grid; gap: var(--space-5); }
  .shop-band-text .display { margin: 0; }
  /* About 420px at 1440. */
  .shop-band-text p { max-width: 16.8em; line-height: 1.15; }
  @media (max-width: 47.99rem) {
    .shop-band-inner { flex-direction: column; gap: var(--block-gap); text-align: center; }
    .shop-band-text { justify-items: center; }
  }

  /* The grid: three squares (343px at 1440, 28px apart) in a centred
     --wrap-shop column from 64rem, two from 40rem, one below. */
  .shop-grid { padding-block: var(--section-y); }
  .products {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--section-y) calc(var(--space-5) + var(--space-1));
    max-width: var(--wrap-shop);
    margin: 0 auto;
    padding: 0;
  }
  @media (min-width: 40rem) { .products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .products { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Each card fills its grid row as a column, so the action (button or
     "Coming soon" box) sits at the bottom and lines up across the row. */
  .card { display: flex; flex-direction: column; color: var(--burgundy); }

  /* The square tile: a photo fills it (cover); a cutout sits whole on the
     page colour with padding (contain); the gift card is a burgundy square
     with the butter wordmark. No border, no box, no shadow. */
  .tile { aspect-ratio: 1; overflow: hidden; }
  .tile :global(.tile-img) { display: block; width: 100%; height: 100%; }
  .tile--contain :global(.tile-img) { padding: var(--block-gap); }
  .tile--contain :global(.tile-img img) { object-fit: contain; }
  .tile--giftcard { background: var(--burgundy); }
  .giftcard {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    color: var(--butter);
  }
  .giftcard :global(.giftcard-mark) { width: 45%; height: auto; color: var(--butter); }
  .giftcard-label { font-size: var(--fs-item); }

  /* Under the tile: the name (Owners Narrow 700, uppercase) left and the
     price right on one baseline (the price wraps under the name when there's
     no room), then the description and the action. */
  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .card-name {
    font-size: var(--fs-item);
    line-height: 1.15;
    color: var(--burgundy);
  }
  .card-price {
    font-size: var(--fs-item);
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .card-note {
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    line-height: 1.15;
    color: color-mix(in srgb, var(--burgundy) 80%, var(--butter));
  }
  .card p { max-width: none; }
  .card > :nth-last-child(2) { margin-bottom: var(--space-4); }
  .card-action { margin-top: auto; align-self: flex-start; }
</style>
