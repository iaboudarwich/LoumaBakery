---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { siteConfig } from '../config/site';
import { features as f } from '../config/features';
import { hoursGroups } from '../lib/hours';
import Img from '../components/Img.astro';
import Doodle from '../components/Doodle.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import { resolveImage as pick } from '../lib/images';

// The home page is burgundy (BaseLayout tone). Every word comes from
// copy.json ("home"), every photo and its alt text from images.json, the
// address and hours from settings.json.
const home = (await getEntry('copy', 'home'))!.data;
const images = (await getEntry('images', 'images'))!.data;
const heroPhoto = pick(images.hero);
const kitchen = images.homeKitchen && { photo: pick(images.homeKitchen.image), alt: images.homeKitchen.alt, focus: images.homeKitchen.focus };
const { address, directionsUrl } = siteConfig;
const hours = hoursGroups();

// The full-bleed hero, art-directed: a wide 9:5 crop from 48rem up (the
// box is min(55.6vw, 800px) tall), a 2:3 crop on phones (70svh tall). Both
// are centred crops, the crop object-fit: cover would make anyway. AVIF
// quality 45 keeps the phone LCP file under 150KB (CLAUDE.md).
const HERO_QUALITY = 45;
const crops = [
  { media: '(min-width: 48rem)', ratio: 9 / 5, widths: [1024, 1440, 1920, 2560] },
  { media: '', ratio: 2 / 3, widths: [600, 900, 1200] },
];
const srcset = async (ratio: number, widths: number[], format: 'avif' | 'webp') =>
  heroPhoto
    ? (await Promise.all(widths.map((w) => getImage({ src: heroPhoto, width: w, height: Math.round(w / ratio), fit: 'cover', position: 'center', format, quality: HERO_QUALITY }))))
        .map((img, i) => `${img.src} ${widths[i]}w`).join(', ')
    : '';
const hero = heroPhoto && {
  sources: await Promise.all(
    crops.flatMap((c) => (['avif', 'webp'] as const).map(async (format) => ({ media: c.media, type: `image/${format}`, srcset: await srcset(c.ratio, c.widths, format) }))),
  ),
  fallback: await getImage({ src: heroPhoto, width: 1440, height: 800, fit: 'cover', position: 'center', format: 'jpeg', quality: 70 }),
};

const reveal = f.reveal ? 'reveal' : undefined;
---

<BaseLayout schema="bakery" tone="burgundy" description={describe([home.tagline, ...home.body])}>
  {/* 1. Hero: the croissant photo edge to edge, the tagline centred on it. */}
  <section class="home-hero">
    {hero && (
      <picture class="hero-photo">
        {hero.sources.map((s) => <source media={s.media || undefined} type={s.type} srcset={s.srcset} sizes="100vw" />)}
        <img src={hero.fallback.src} width={hero.fallback.attributes.width} height={hero.fallback.attributes.height} alt={images.heroAlt} class="img-cover" loading="eager" decoding="auto" fetchpriority="high" />
      </picture>
    )}
    <h1 class="display hero-tagline">{home.tagline}</h1>
  </section>

  {/* 2. Intro: the two paragraphs in a centred column. */}
  <section class="section home-intro">
    <div class="container" data-anim={reveal}>
      <div class="home-body">{home.body.map((p) => <p class="lead">{p}</p>)}</div>
    </div>
  </section>

  {/* 3. The kitchen, edge to edge. */}
  {kitchen?.photo && <Img src={kitchen.photo} alt={kitchen.alt} focus={kitchen.focus} class="home-kitchen" sizes="100vw" widths={[800, 1200, 1600, 2000, 2400, 3200]} />}

  {/* 4. Visit: the bread slice, the address with directions, the hours. */}
  <section class="section visit-row" aria-labelledby="visit-h">
    <div class="container visit-inner" data-anim={reveal}>
      <h2 id="visit-h" class="visually-hidden">Visit</h2>
      <Doodle name="bread-slice" size={120} color="butter" animate={f.doodleDraw} class="visit-slice" />
      <div class="visit-where">
        <address>{address.street},<br />{address.city}, {address.state} {address.zip}</address>
        <p class="visit-directions"><a href={directionsUrl} target="_blank" rel="noopener">Get Directions</a></p>
      </div>
      <div class="visit-hours">
        {hours.map((g) => <p>{g.lines.map((l, i) => (i ? <><br />{l}</> : l))}</p>)}
      </div>
    </div>
  </section>

  {/* 5. Instagram: six tiles edge to edge, then "Follow along" and the handle. */}
  <section class="home-ig" aria-labelledby="ig-h">
    <InstagramStrip title={home.instagramTitle} />
  </section>
  {/* The footer comes from BaseLayout (butter on this page). */}
</BaseLayout>

<style>
  /* 1. Hero: min(55.6vw, 800px) tall from 48rem (800 at 1440), 70svh on
     phones. The tagline sits in the middle, butter, on two lines at 1440. */
  .home-hero {
    position: relative;
    display: grid;
    place-items: center;
    height: min(55.6vw, 800px);
    overflow: hidden;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-tagline {
    position: relative;
    z-index: 1;
    max-width: 14em;
    margin: 0;
    padding-inline: var(--gutter);
    color: var(--butter);
    text-align: center;
  }
  /* The one scrim on the site: the croissants' highlights fall to 1.2:1
     against butter, so ink at 52% sits behind the words (solid to 80% of an
     ellipse twice the text's size, then fading out). It brings every pixel
     behind the letters to at least 3:1. */
  .hero-tagline::before {
    content: '';
    position: absolute;
    inset: -100% -50%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ink) 52%, transparent) 80%, transparent);
  }
  @media (max-width: 47.99rem) {
    .home-hero { height: 70vh; height: 70svh; }
  }

  /* 2. Intro: the lead size, a centred column (about 740px at 1440), set
     left for reading. */
  .home-intro { padding-block: var(--section-y); }
  .home-body { max-width: 24.5em; margin-inline: auto; font-size: var(--fs-lead); }
  .home-body .lead { max-width: none; font-size: var(--fs-lead); line-height: 1.15; color: var(--butter); }

  /* 3. Kitchen: min(50.7vw, 730px) tall from 48rem (730 at 1440), 4:3 on
     phones. */
  :global(.home-kitchen) { display: block; width: 100%; height: min(50.7vw, 730px); }
  @media (max-width: 47.99rem) {
    :global(.home-kitchen) { height: auto; aspect-ratio: 4 / 3; }
  }

  /* 4. Visit row: the drawing, the address, the hours, centred as a group
     at the lead size. Phones: stacked, left-aligned. */
  .visit-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--block-gap) calc(var(--block-gap) * 2.5);
    font-size: var(--fs-lead);
    line-height: 1.15;
  }
  .visit-inner :global(.visit-slice) { width: clamp(80px, 8.3vw, 120px); }
  .visit-where address { font-style: normal; }
  .visit-directions { margin-top: 1em; }
  .visit-directions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-line: underline;
  }
  .visit-hours p + p { margin-top: 1em; }
  @media (max-width: 47.99rem) {
    .visit-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
