---
import { getEntry } from 'astro:content';
import { siteConfig } from '../config/site';
import { features, hiddenRoutes } from '../config/features';
import { Wordmark } from '../lib/brand';
import FaceDraw from './FaceDraw.astro';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  /** Show the footer newsletter. Pages with their own signup (home) pass false. */
  newsletter?: boolean;
}
// The signup also needs features.newsletter on (off for now).
const newsletter = (Astro.props.newsletter ?? true) && features.newsletter;

const { address, hours, links } = siteConfig;
const year = new Date().getFullYear();
const home = (await getEntry('copy', 'home'))?.data;

// Pages switched off in features.ts (hiddenRoutes) are not linked.
const explore = [
  { label: 'Our Story', href: '/story' },
  { label: 'The Louma Initiative', href: '/initiative' },
  { label: 'Menu', href: '/menu' },
  { label: 'Shop', href: '/shop' },
  { label: 'Catering', href: '/catering' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/visit' },
].filter((l) => !hiddenRoutes.includes(l.href));
---

<footer class="site-foot">
  <div class="container foot-inner">
    <!-- Newsletter: on every page's footer except those with their own signup. -->
    {newsletter && (
      <div class="foot-newsletter" id="newsletter">
        <div class="foot-news">
          {home?.newsletterTitle && <p class="foot-news-h">{home.newsletterTitle}</p>}
          {home?.newsletterBody && <p class="foot-news-body">{home.newsletterBody}</p>}
          <NewsletterForm variant="footer" />
        </div>
      </div>
    )}

    <div class="foot-cols">
      <!-- Brand -->
      <div class="foot-col foot-brand">
        <FaceDraw class="foot-face" width={104} height={96} color="var(--white)" />
        <Wordmark class="foot-wordmark" width={180} height={116} aria-label={siteConfig.name} />
      </div>

      <!-- Visit -->
      <div class="foot-col">
        <h2 class="foot-h">Visit</h2>
        <address class="foot-address">
          <p>{address.street}<br />{address.city}, {address.state} {address.zip}</p>
          <ul class="foot-hours" role="list">
            {
              hours.map((h) => (
                <li>
                  <span class="mono">{h.days}</span>
                  <span class="mono foot-hours-time">{h.close ? `${h.open}–${h.close}` : h.open}</span>
                </li>
              ))
            }
          </ul>
          <p class="foot-contact">
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a><br />
            <a href={`mailto:${siteConfig.ordersEmail}`}>{siteConfig.ordersEmail}</a> for larger orders
          </p>
        </address>
      </div>

      <!-- Explore -->
      <div class="foot-col">
        <h2 class="foot-h">Explore</h2>
        <ul class="foot-links" role="list">
          {explore.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
          <li><a href={links.instagram} target="_blank" rel="noopener">Instagram</a></li>
          {links.tiktok && <li><a href={links.tiktok} target="_blank" rel="noopener">TikTok</a></li>}
        </ul>
      </div>
    </div>

    <div class="foot-base">
      <p class="mono">© {year} {siteConfig.name}.</p>
      <p class="mono">Wilshire · Santa Monica</p>
    </div>
  </div>
</footer>

<style>
  /* Louma Red, every word white in Owners Narrow Bold at 19px or more. White
     on red is 4.24:1, which passes AA only as large bold text, so nothing in
     the footer is set smaller or lighter. Hairlines are white at 30%. */
  .site-foot {
    --foot-line: color-mix(in srgb, var(--white) 30%, transparent);
    background: var(--red);
    color: var(--white);
    font-family: var(--font-narrow);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.5;
    padding-block: var(--space-8) var(--space-6);
    margin-top: var(--space-8);
  }
  .site-foot p { max-width: none; }

  .foot-newsletter {
    padding-bottom: var(--space-7);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--foot-line);
  }
  .foot-news { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .foot-news-h { font-size: clamp(20px, 2.4vw, 28px); }
  .foot-news-body { margin-top: var(--space-2); }
  /* Newsletter form/input styling lives in NewsletterForm.astro (scoped to where it renders). */

  .foot-cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-7);
  }

  .foot-brand .foot-wordmark {
    color: var(--white);
    margin-top: var(--space-2);
    height: auto;
  }

  /* Column labels: the same white Narrow Bold as everything else here. */
  .foot-h {
    font-family: var(--font-narrow);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.5;
    color: var(--white);
    margin-bottom: var(--space-4);
  }

  .foot-address {
    font-style: normal;
  }
  .foot-hours {
    margin: var(--space-3) 0;
    padding: 0;
  }
  .foot-hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 2px 0;
  }
  /* The data voice keeps its tabular figures, in the footer's face. */
  .site-foot .mono { font-family: inherit; font-weight: inherit; }

  .foot-links {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .foot-links a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; } /* tap targets */

  .site-foot a {
    color: var(--white);
    text-decoration: none;
  }
  /* Hover: an underline, never a colour change. */
  @media (hover: hover) and (pointer: fine) {
    .site-foot a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
  }
  .site-foot :global(:focus-visible) { outline: 2px solid var(--white); outline-offset: 3px; }

  .foot-base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--foot-line);
  }
  /* Two lines on one row: no paragraph gap above the second. */
  .foot-base p + p { margin-top: 0; }

  @media (max-width: 760px) {
    .foot-cols {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
