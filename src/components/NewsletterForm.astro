---
import { siteConfig } from '../config/site';

/**
 * The newsletter signup form (Netlify Forms), rendered once, in the global
 * footer. Copy comes from siteConfig.forms.
 */
interface Props {
  /** Kept for the footer's call site; the footer is the only variant now. */
  variant?: 'footer';
}
const id = 'foot-news-email';
const rowClass = 'foot-news-row';
const formClass = 'foot-news-form';
---

<form
  name="newsletter"
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  class={formClass}
>
  <input type="hidden" name="form-name" value="newsletter" />
  {/* Messages live in hidden elements, not form attributes: Netlify rewrites the
      <form> tag at deploy and mangles apostrophes in its attribute values. */}
  <span hidden data-form-msg="success">{siteConfig.forms.newsletterSuccess}</span>
  <span hidden data-form-msg="error">{siteConfig.forms.error}</span>
  <p class="visually-hidden" aria-hidden="true"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  <label class="visually-hidden" for={id}>Email address</label>
  <div class={rowClass}>
    <input id={id} type="email" name="email" required placeholder="you@email.com" autocomplete="email" inputmode="email" />
    <button type="submit" class="btn btn-coral">Notify me</button>
  </div>
</form>

<style>
  /* Styles live here (not the parent) because the input is rendered by this
     component; Astro's scoped styles don't reach a child's elements. */
  .foot-news-form { flex: 1; min-width: min(280px, 100%); max-width: 460px; }

  .foot-news-row {
    display: flex;
    gap: var(--space-2);
  }
  .foot-news-row input {
    flex: 1;
    min-height: 48px;
    padding: 0 0.9rem;
    font-size: clamp(16px, calc(16px + (100vw - 1920px) * 0.003125), 18px); /* iOS zooms on focus below 16px */
    border: 1px solid var(--white);
    border-radius: 0;
    background: var(--white); /* the footer is burgundy: a white field, ink text */
    color: var(--ink);
  }
  .foot-news-row input::placeholder {
    color: var(--muted);
  }
  /* The global filled button is burgundy, the footer's own colour: here it
     turns butter with burgundy text. */
  :global(html.sys-slab) .foot-news-row .btn-coral {
    background: var(--butter);
    border-color: var(--butter);
    color: var(--burgundy);
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html.sys-slab) .foot-news-row .btn-coral:hover { background: var(--ink); border-color: var(--ink); color: var(--butter); }
  }
  @media (max-width: 520px) {
    .foot-news-row { flex-direction: column; }
  }
</style>
