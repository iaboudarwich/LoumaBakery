---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { features as f } from '../config/features';
import Img from '../components/Img.astro';
import { Wordmark, WORDMARK_ART } from '../lib/brand';
import { resolveImage } from '../lib/images';

// Words: copy.json ("shop": the title and the "Coming soon" words). The intro
// line and the products, in the order shown: shop.json (CMS: "Shop"). A plain
// grid of product cards, no boxes. A product with a link is one link (new
// tab); without one it shows "Coming soon" and is not a link.
const c = (await getEntry('copy', 'shop'))!.data;
const shop = (await getEntry('shop', 'shop'))!.data;
const soon = c.status ?? '';
const products = shop.products.map((p) => ({ ...p, photo: p.image ? resolveImage(p.image) : undefined }));
const reveal = f.reveal ? 'reveal' : undefined;
const SIZES = '(max-width: 39.99rem) 100vw, (max-width: 63.99rem) 50vw, min(33vw, 440px)';
---

<BaseLayout title={c.title} description={describe([shop.intro])}>
  <header class="page-intro">
    <div class="container">
      <div class="page-intro-split">
        <h1 class="display">{noOrphan(c.title ?? '')}</h1>
        {shop.intro && <div class="page-intro-body"><p class="lead">{shop.intro}</p></div>}
      </div>
    </div>
  </header>

  <section class="section shop-grid" aria-label="Products">
    <div class="container">
      <ul class="products" role="list" data-anim={reveal} data-reveal-children>
        {products.map((p) => {
          const Tag = p.link ? 'a' : 'div';
          const linkAttrs = p.link ? { href: p.link, target: '_blank', rel: 'noopener' } : {};
          return (
            <li>
              <Tag class:list={['card', p.link && 'card--linked']} {...linkAttrs}>
                <div class:list={['tile', `tile--${p.kind === 'giftcard' ? 'giftcard' : p.fit}`]}>
                  {p.kind === 'giftcard' ? (
                    <div class="giftcard" aria-hidden="true">
                      <Wordmark class="giftcard-mark" viewBox={WORDMARK_ART} width={180} height={66} />
                      <span class="giftcard-label">Gift card</span>
                    </div>
                  ) : p.photo ? (
                    <Img src={p.photo} alt={p.alt || p.name} class="tile-img" sizes={SIZES} widths={[480, 720, 960]} />
                  ) : null}
                </div>
                <div class="card-head">
                  <h2 class="card-name">{p.name}</h2>
                  {p.price && <p class="card-price">{p.price}</p>}
                </div>
                {p.note && <p class="card-note">{p.note}</p>}
                {p.link
                  ? <span class="visually-hidden"> (opens in a new tab)</span>
                  : soon && <p class="label card-status">{soon}</p>}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-grid { padding-top: 0; }

  /* 3 columns from 64rem, 2 from 40rem, 1 below. */
  .products {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--block-gap);
    margin: 0;
    padding: 0;
  }
  @media (min-width: 40rem) { .products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .products { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .card { display: block; color: var(--burgundy); text-decoration: none; }

  /* The square tile: a photo fills it (cover); a cutout sits whole on the
     page colour with padding (contain); the gift card is a burgundy square
     with the butter wordmark. No border, no box, no shadow. */
  .tile { aspect-ratio: 1; overflow: hidden; }
  .tile :global(.tile-img) { display: block; width: 100%; height: 100%; }
  .tile--contain :global(.tile-img) { padding: var(--block-gap); }
  .tile--contain :global(.tile-img img) { object-fit: contain; }
  .tile--giftcard { background: var(--burgundy); }
  .giftcard {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    color: var(--butter);
  }
  .giftcard :global(.giftcard-mark) { width: 45%; height: auto; color: var(--butter); }
  .giftcard-label { font-weight: 500; font-size: var(--fs-item); }

  /* Under the tile: the name left and the price right on one baseline (the
     price wraps under the name when there's no room), then the note and the
     status. */
  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .card-name {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs-item);
    line-height: 1.3;
    letter-spacing: var(--track-body);
    color: var(--burgundy);
    text-decoration-line: none;
    text-decoration-style: solid;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--red);
    text-underline-offset: 0.2em;
  }
  .card-price {
    font-size: var(--fs-item);
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }
  .card-note {
    margin-top: var(--space-2);
    font-size: var(--fs-body);
    line-height: 1.45;
    color: color-mix(in srgb, var(--burgundy) 80%, var(--butter));
  }
  .card-status { margin-top: var(--space-3); color: var(--burgundy); }
  .card p { max-width: none; }

  /* A linked card: the 2px red underline on its name on hover and focus. */
  @media (hover: hover) and (pointer: fine) {
    .card--linked:hover .card-name { text-decoration-line: underline; }
  }
  .card--linked:focus-visible .card-name { text-decoration-line: underline; }
</style>
