---
import { getEntry, getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { features as f } from '../config/features';
import Sketch from '../components/Sketch.astro';
import { resolveImage } from '../lib/images';
import { noOrphan } from '../lib/typography';
import menuData from '../data/menu.json';

const c = (await getEntry('copy', 'menu'))!.data;
const menu = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);

// Permanent square thumbnails, cropped at build time. 320w covers the largest
// everyday slot (96px) at 3x; 160w serves 1x and 2x screens.
const THUMB = { widths: [160, 320], width: 320, height: 320, fit: 'cover' as const };
// Mirrors the .row-thumb clamp below: ~64px on phones, 96px from 660px, 128px past 1920px.
const THUMB_SIZES = '(min-width: 1921px) 128px, (min-width: 660px) 96px, 64px';
const thumbs: Record<string, { avif: string; webp: string; src: string }> = {};
for (const cat of menu) {
  for (const item of cat.data.items) {
    const meta = resolveImage(item.image);
    if (!meta) continue;
    const [avif, webp] = await Promise.all([
      getImage({ src: meta, ...THUMB, format: 'avif' }),
      getImage({ src: meta, ...THUMB, format: 'webp' }),
    ]);
    thumbs[item.name] = { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src };
  }
}
// Data-driven add-ons list, rendered right after the category named in the data.
const addOns = menuData.addOns;
---

<BaseLayout title="Menu" description={c.lede}>
  <header class="page-head menu-head">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{noOrphan(c.title ?? '')}</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
      <Sketch name="baguette" width={150} height={54} class="head-sketch" color="var(--clay)" draw={f.scrollDraw} />
    </div>
  </header>

  {/* Sticky category pill nav (progressive: plain anchors; scroll-spy is JS-enhanced) */}
  <nav class="pillnav" aria-label="Menu categories">
    <ul class="pillnav-track container" role="list">
      {menu.map((cat) => (
        <li>
          <a class="pill" href={`#menu-${cat.id}`} data-spy={`menu-${cat.id}`}>{cat.data.title}</a>
        </li>
      ))}
    </ul>
    {/* Flat edge caps: shown by JS only while more pills sit off that edge
        (hidden attr = fail-safe, the rail still scrolls without JS). Pointer
        affordance only; keyboard users reach every pill by Tab. */}
    <button type="button" class="pillnav-more pillnav-more--start" data-rail="-1" tabindex="-1" aria-hidden="true" hidden>&larr;</button>
    <button type="button" class="pillnav-more pillnav-more--end" data-rail="1" tabindex="-1" aria-hidden="true" hidden>&rarr;</button>
  </nav>

  <div class="container menu-body">
    {menu.map((cat) => (
      <>
      <section class="menu-cat" id={`menu-${cat.id}`} aria-labelledby={`h-${cat.id}`} data-anim={f.reveal ? 'reveal' : undefined}>
        <h2 class="menu-cat-title smallcaps" id={`h-${cat.id}`}>{cat.data.title}</h2>
        <ul class="menu-rows" role="list">
          {cat.data.items.map((item) => (
            <li class="menu-row">
              <div class="row-text">
                <div class="row-head">
                  <h3 class="row-name">{noOrphan(item.name)}</h3>
                  {item.price && (
                    <>
                      <span class="row-dots" aria-hidden="true"></span>
                      <span class="row-price mono">{item.price}</span>
                    </>
                  )}
                </div>
                {item.description && <p class="row-desc">{item.description}</p>}
                {item.tags.length > 0 && (
                  <ul class="product-tags" role="list">
                    {item.tags.map((t) => <li class="tag mono">{t}</li>)}
                  </ul>
                )}
              </div>
              {thumbs[item.name] && (
                <picture class="row-thumb">
                  <source type="image/avif" srcset={thumbs[item.name].avif} sizes={THUMB_SIZES} />
                  <img
                    class="img-cover"
                    src={thumbs[item.name].src}
                    srcset={thumbs[item.name].webp}
                    sizes={THUMB_SIZES}
                    alt={item.alt ?? item.name}
                    width="320"
                    height="320"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                </picture>
              )}
            </li>
          ))}
        </ul>
      </section>
      {addOns && cat.id === addOns.afterCategory && addOns.items.length > 0 && (
        <aside class="menu-addons" aria-labelledby="h-addons">
          <p class="eyebrow" id="h-addons">{addOns.title}</p>
          <ul class="addons-list" role="list">
            {addOns.items.map((a) => (
              <li class="addon mono">{a.name} <span class="addon-price">{a.price}</span></li>
            ))}
          </ul>
        </aside>
      )}
      </>
    ))}

    {c.allergenNote && (
      <aside class="allergen" aria-label="Allergens">
        <p class="eyebrow">Allergens</p>
        <p>{c.allergenNote}</p>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .pillnav {
    position: sticky;
    top: var(--nav-h);
    z-index: 500;
    background: color-mix(in srgb, var(--surface-0) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--hairline);
  }
  .pillnav-track {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-block: var(--space-3);
    scrollbar-width: none;
  }
  .pillnav-track::-webkit-scrollbar { display: none; }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--body);
    font-family: var(--font-mono);
    font-weight: 400; /* DM Mono ships 400/500 only: never ask for a light it doesn't have */
    font-size: clamp(13px, calc(13px + (100vw - 1920px) * 0.002344), 14.5px);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pill:hover { background: var(--surface-3); }
  }
  .pill { min-width: 44px; }
  /* Native momentum + snap on the pill rail. */
  /* scroll-padding = the container gutter, so start-snap rests the first pill
     at the gutter instead of pulling it under the left edge. */
  .pillnav-track {
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
    scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
  }
  .pill { scroll-snap-align: start; flex: 0 0 auto; }
  .pill[aria-current='true'] { background: var(--burgundy); color: var(--butter); }
  /* Scroll affordance: solid cream cap + hairline over the cut-off pill. */
  .pillnav-more {
    position: absolute;
    inset-block: 0;
    width: 48px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: var(--surface-0);
    color: var(--burgundy);
    font-family: var(--font-mono);
    font-size: clamp(18px, calc(18px + (100vw - 1920px) * 0.003906), 20.5px);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .pillnav-more[hidden] { display: none; }
  /* Caps reach the true edge; the landscape safe-area inset is added as padding
     so the arrow never sits under a notch. */
  .pillnav-more--end { inset-inline-end: 0; width: calc(48px + env(safe-area-inset-right, 0px)); padding-inline-end: env(safe-area-inset-right, 0px); border-inline-start: 1px solid var(--hairline-strong); }
  .pillnav-more--start { inset-inline-start: 0; width: calc(48px + env(safe-area-inset-left, 0px)); padding-inline-start: env(safe-area-inset-left, 0px); border-inline-end: 1px solid var(--hairline-strong); }

  /* Add-ons: small mono chips under their drink categories. */
  .menu-addons { padding-top: var(--space-5); }
  .addons-list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .addon {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    font-size: clamp(13px, calc(13px + (100vw - 1920px) * 0.002344), 14.5px);
    color: var(--body);
  }
  .addon-price { color: var(--burgundy); }

  .menu-body { padding-block: var(--space-7) var(--space-9); }
  .menu-cat { padding-top: var(--space-6); scroll-margin-top: calc(var(--nav-h) + 64px); }
  .menu-cat-title { font-size: clamp(24px, 3vw, 34px); color: var(--clay); margin-bottom: var(--space-5); }

  .menu-rows { display: flex; flex-direction: column; }
  /* Row: name, dotted leader, price, then the photo thumbnail when the item has one. */
  .menu-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }
  .row-text { flex: 1; min-width: 0; }
  /* Every row keeps the same 44px minimum box, with or without a photo. */
  .row-head { display: flex; align-items: baseline; gap: var(--space-3); min-height: 44px; padding-block: 2px; }
  /* line-height: inherit so the <h3> keeps body leading instead of the tighter
     global heading rule. */
  .row-name { text-wrap: balance; line-height: inherit; font-family: var(--font-display); font-weight: 500; font-size: clamp(22px, calc(22px + (100vw - 1920px) * 0.004687), 25px); color: var(--ink); display: inline-block; }
  .row-dots { flex: 1; border-bottom: 1px dotted color-mix(in srgb, var(--ink) 28%, transparent); transform: translateY(-4px); }
  .row-price { color: var(--burgundy); font-size: clamp(16px, calc(16px + (100vw - 1920px) * 0.003125), 18px); }
  .row-desc { margin-top: var(--space-2); color: var(--muted); max-width: 60ch; }
  /* .tag chip style is global (one badge language site-wide). */
  .product-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  /* Thumbnail: ~64px at 390, 96px from ~660px, never under 48px or over 128px;
     past 1920px it grows with the large-screen policy. The negative block margin
     lets it use most of the row padding, keeping photo rows close to name-only
     rows in height. Rows without a photo render nothing here. */
  .row-thumb {
    --thumb: clamp(48px, min(12vw + 17px, max(96px, 96px + (100vw - 1920px) * 0.05)), 128px);
    flex: 0 0 auto;
    width: var(--thumb);
    height: var(--thumb);
    margin-block: calc(var(--space-3) * -1);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .allergen {
    margin-top: var(--space-8);
    padding: var(--space-5);
    background: var(--surface-2);
    border-radius: var(--radius-lg);
    max-width: 70ch;
  }
  .allergen p:last-child { margin-top: var(--space-2); color: var(--body); }

  /* --- Slab: typographic list --- */
  /* 720px measure up to 1920px, then it grows with the container. */
  :global(html.sys-slab) .menu-cat,
  :global(html.sys-slab) .menu-addons { max-width: clamp(720px, calc(720px + (100vw - 1920px) * 0.375), 960px); }
  :global(html.sys-slab) .row-name { font-size: clamp(26px, 2.8vw, 34px); font-weight: 400; }

  /* Hand-drawn baguette tucked into the header corner. */
  .menu-head { position: relative; overflow: hidden; }
  .menu-head .container { position: relative; }
  /* :global — the class lands on the Sketch CHILD component's svg, which a
     page-scoped selector cannot reach. */
  .menu-head :global(.head-sketch) {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0;
    width: clamp(100px, 11vw, 150px);
    height: auto;
  }
  @media (max-width: 680px) {
    .menu-head :global(.head-sketch) { position: static; margin-top: var(--space-5); width: 110px; }
  }
</style>

<script>
  // Scroll-spy: highlight the pill for the section in view. Progressive —
  // anchors already work; this only adds aria-current. Throttled by IO.
  const pills = Array.from(document.querySelectorAll<HTMLAnchorElement>('.pill[data-spy]'));
  const byId = new Map(pills.map((p) => [p.dataset.spy!, p]));
  const sections = pills.map((p) => document.getElementById(p.dataset.spy!)).filter(Boolean) as HTMLElement[];

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const scrollBehavior = (): ScrollBehavior => (reduceMotion.matches ? 'auto' : 'smooth');

  // Edge caps: reveal whichever side still has pills off-screen.
  const rail = document.querySelector<HTMLElement>('.pillnav-track');
  const caps = Array.from(document.querySelectorAll<HTMLButtonElement>('.pillnav-more'));
  if (rail && caps.length && rail.querySelector('.pill')) {
    let queued = false;
    const pillEls = rail.querySelectorAll<HTMLElement>('.pill');
    const first = pillEls[0];
    const last = pillEls[pillEls.length - 1];
    // Compare pill edges, not scrollLeft: snap + container padding mean the
    // rail can rest at a non-zero offset with every leading pill visible.
    const update = () => {
      queued = false;
      const box = rail.getBoundingClientRect();
      caps.forEach((cap) => {
        const edge = cap.dataset.rail === '1' ? last : first;
        const r = edge.getBoundingClientRect();
        cap.hidden = cap.dataset.rail === '1' ? r.right <= box.right + 1 : r.left >= box.left - 1;
      });
    };
    const queue = () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    };
    rail.addEventListener('scroll', queue, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(queue).observe(rail);
    caps.forEach((cap) => cap.addEventListener('click', () => {
      rail.scrollBy({ left: Number(cap.dataset.rail) * rail.clientWidth * 0.7, behavior: scrollBehavior() });
    }));
    update();
  }

  if ('IntersectionObserver' in window && sections.length) {
    const setActive = (id: string) => {
      pills.forEach((p) => p.removeAttribute('aria-current'));
      const active = byId.get(id);
      active?.setAttribute('aria-current', 'true');
      // Keep the active pill visible in the rail.
      active?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: scrollBehavior() });
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
