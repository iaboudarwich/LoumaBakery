---
import { getEntry } from 'astro:content';
import { noOrphan } from '../lib/typography';
import BaseLayout from '../layouts/BaseLayout.astro';
import { describe } from '../lib/seo';
import { features as f } from '../config/features';
import Img from '../components/Img.astro';
import Doodle from '../components/Doodle.astro';
import { resolveImage } from '../lib/images';
import Signature from '../assets/brand/signature-milla.svg';

// Words: copy.json ("story") for the title, story.json for the letter and the
// sections (CMS: "Our Story"). Photos: images.json `story` (CMS: "Photos").
const c = (await getEntry('copy', 'story'))!.data;
const { letter, sections } = (await getEntry('story', 'story'))!.data;
const images = (await getEntry('images', 'images'))!.data;
const photos = images.story.map((p) => ({ photo: resolveImage(p.image), alt: p.alt, focus: p.focus }));

// A small drawing beside each section title, by position (the sections keep
// their drawing if the owner edits a title).
const sectionDoodles = ['palm', 'bread-slice', 'herb', 'hearts'];
// The photo sits after a section, by position: the collage after the first
// ("Sister-run").
const photoAfter: Record<number, number> = { 0: 0 };
// The page as a run of sections: text rows, then a photo section wherever a
// photo follows, like the home page's photo sections (same grid gap, same
// section spacing).
type Row = (typeof sections)[number] & { i: number };
const runs: ({ rows: Row[] } | { photo: (typeof photos)[number] })[] = [];
sections.forEach((s, i) => {
  const last = runs[runs.length - 1];
  if (last && 'rows' in last) last.rows.push({ ...s, i });
  else runs.push({ rows: [{ ...s, i }] });
  const ph = photoAfter[i] !== undefined ? photos[photoAfter[i]] : undefined;
  if (ph?.photo) runs.push({ photo: ph });
});
const reveal = f.reveal ? 'reveal' : undefined;
---

<BaseLayout title={c.title} description={describe(letter.paragraphs)}>
  <header class="page-intro story-intro">
    <div class="container">
      <h1 class="display">{noOrphan(c.title ?? '')}</h1>
    </div>
  </header>

  {/* The letter: straight on the page, one --block-gap under the title. */}
  <section class="section letter-band">
    <div class="container">
      <article class="letter" data-anim={reveal}>
        <Doodle name="sun" size={64} color="red" animate={f.doodleDraw} class="letter-sun" />
        {letter.paragraphs.map((p) => <p class="letter-p">{p}</p>)}
        <Signature class="letter-signature" role="img" aria-label={letter.signature} />
        <Doodle name="moon-stars" size={64} color="red" animate={f.doodleDraw} class="letter-moon" />
      </article>
    </div>
  </section>

  {/* The sections: title 4 columns, copy 7; the collage after the first,
      in its own section. */}
  {runs.map((run) =>
    'rows' in run ? (
      <section class="section">
        <div class="container">
          {run.rows.map((s) => (
            <div class="grid-12 text-row" data-anim={reveal}>
              <div class="text-row-title">
                {sectionDoodles[s.i] && <Doodle name={sectionDoodles[s.i]!} size={56} color="red" animate={f.doodleDraw} />}
                <h2 class="h2">{s.title}</h2>
              </div>
              <div class="text-row-body">{s.paragraphs.map((p) => <p>{p}</p>)}</div>
            </div>
          ))}
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container grid-12">
          <Img src={run.photo.photo!} alt={run.photo.alt} focus={run.photo.focus} class="ph ph--portrait" style="--start: 4; --span: 6" sizes="(max-width: 47.99rem) 100vw, min(48vw, 680px)" />
        </div>
      </section>
    ),
  )}
</BaseLayout>

<style>
  /* The title sits one --block-gap above the letter. */
  .story-intro { padding-bottom: var(--block-gap); }
  .letter-band { padding-top: 0; }
  /* The letter sits on the page itself (no card): max 680px, centred. */
  .letter {
    position: relative;
    max-width: 680px;
    margin-inline: auto;
  }
  /* The letter at the section text's size (--fs-lead), in burgundy. */
  .letter-p {
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--burgundy);
    max-width: none;
  }
  .letter-p + .letter-p { margin-top: 1em; }
  /* Sun top right, signature right, moon and stars bottom left, all in the
     letter's own column. */
  .letter :global(.letter-sun) {
    display: block;
    width: clamp(44px, 5vw, 64px);
    margin: 0 0 var(--space-4) auto;
  }
  .letter :global(.letter-signature) {
    display: block;
    width: 140px;
    height: auto;
    margin: var(--block-gap) 0 0 auto;
    color: var(--red);
  }
  .letter :global(.letter-moon) {
    display: block;
    width: clamp(44px, 5vw, 64px);
    margin-top: var(--space-4);
  }
</style>
