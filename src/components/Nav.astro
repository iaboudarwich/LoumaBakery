---
import { siteConfig } from '../config/site';
import MobilePanel from './MobilePanel.astro';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

// Nav links — single source. `Order` CTA is separate (external).
const links = [
  { label: 'Menu', href: '/menu' },
  { label: 'Our Story', href: '/story' },
  { label: 'Mission', href: '/mission' },
  { label: 'Catering', href: '/catering' },
  { label: 'Careers', href: '/careers' },
  { label: 'Visit', href: '/visit' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;

// Order link is a placeholder until a real Uber Eats URL is set.
const orderReady = !!siteConfig.links.uberEats && siteConfig.links.uberEats !== 'https://www.ubereats.com/';
---

<nav class="site-nav" data-transparent={String(transparent)} aria-label="Primary">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${siteConfig.name} home`}>Louma</a>

    <ul class="nav-links" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-right">
      {orderReady ? (
        <a class="order-cta" href={siteConfig.links.uberEats} target="_blank" rel="noopener">Order</a>
      ) : (
        <span class="order-cta is-inert" aria-disabled="true" title="Online ordering isn't available yet.">Ordering soon</span>
      )}
      <button
        type="button"
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-panel"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile slide-in panel. The CTA is slotted so it keeps this file's .order-cta styles. -->
  <MobilePanel links={links} currentPath={path}>
    {orderReady ? (
      <a slot="cta" class="order-cta order-cta--block" href={siteConfig.links.uberEats} target="_blank" rel="noopener">Order on Uber Eats</a>
    ) : (
      <span slot="cta" class="order-cta order-cta--block is-inert" aria-disabled="true">Ordering soon</span>
    )}
  </MobilePanel>
</nav>

{/* No-JS fallback: the mobile toggle needs JS, so without it surface the links
    inline and hide the dead toggle — mobile visitors keep their navigation. */}
<noscript>
  <style>
    @media (max-width: 860px) {
      .nav-toggle { display: none !important; }
      .nav-links {
        display: flex !important;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        justify-content: flex-end;
      }
    }
  </style>
</noscript>

<style>
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* tap target */
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .brand {
    color: var(--butter);
  }

  .nav-links {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(15px, calc(15px + (100vw - 1920px) * 0.003125), 17px);
    color: var(--body);
    text-decoration: none;
    position: relative;
  }
  /* Touch screens wide enough to show the inline links: 44px wide targets. */
  @media (pointer: coarse) {
    .nav-links a { min-width: 44px; justify-content: center; }
  }
  /* Hover: a burgundy underline draws in from the start edge.
     Active page: a persistent red rule (the one red moment in the bar). */
  .nav-links a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 1px;
    background: var(--burgundy);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-links a:hover { color: var(--burgundy); }
    .nav-links a:hover::after { transform: scaleX(1); }
  }
  .nav-links a:focus-visible::after { transform: scaleX(1); }
  .nav-links a[aria-current='page']::after {
    background: var(--red);
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-links a::after { transition: none; }
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .nav-links a {
    color: color-mix(in srgb, var(--butter) 88%, transparent);
  }
  /* Over the hero scrim the underline reads in butter, not burgundy. */
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .nav-links a::after {
    background: var(--butter);
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .nav-links a[aria-current='page']::after {
    background: var(--peach);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .order-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    background: var(--burgundy);
    color: var(--butter);
    font-family: var(--font-mono);
    font-size: clamp(13px, calc(13px + (100vw - 1920px) * 0.002344), 14.5px);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .order-cta:hover {
      background: var(--red);
      color: var(--butter);
    }
  }
  /* Inert "Ordering soon": same soft coming-soon language as .btn:disabled
     (white chip + burgundy-dashed hairline), sized for the bar. */
  .order-cta.is-inert {
    background: var(--white);
    color: color-mix(in srgb, var(--burgundy) 78%, var(--muted));
    border: 1.5px dashed color-mix(in srgb, var(--burgundy) 55%, transparent);
    cursor: default;
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .order-cta.is-inert {
    background: color-mix(in srgb, var(--ink) 30%, transparent);
    color: color-mix(in srgb, var(--butter) 90%, transparent);
    border-color: color-mix(in srgb, var(--butter) 45%, transparent);
  }

  /* SLAB nav: a persistent FLAT bar, legible at every scroll position.
     Over the photo hero it sits on a solid ink strip (no blur); everywhere
     else solid cream with a hairline. The kill-all rule strips the blur. */
  :global(html.sys-slab) .site-nav[data-scrolled='true'],
  :global(html.sys-slab) .site-nav:not([data-transparent='true']) {
    background: var(--butter);
    border-bottom: 1px solid var(--hairline);
  }
  :global(html.sys-slab) .site-nav[data-transparent='true']:not([data-scrolled='true']) {
    background: color-mix(in srgb, var(--ink) 90%, transparent);
  }
  :global(html.sys-slab) .order-cta { border-radius: 9999px; }

  /* Hide-on-scroll-down / show-on-scroll-up (keeps the glass state). */
  .site-nav { transition: transform 0.35s var(--ease-out); will-change: transform; padding-top: env(safe-area-inset-top, 0px); height: calc(var(--nav-h) + env(safe-area-inset-top, 0px)); }
  .site-nav[data-hidden='true'] { transform: translateY(-100%); }
  /* MOBILE: always-visible slim bar. Hide-on-scroll is desktop-only (Safari's
     toolbar collapse makes mid-scroll nav movement feel broken on iOS). */
  @media (max-width: 768px) {
    .site-nav { --nav-h: 56px; transition: none; will-change: auto; }
    .site-nav[data-hidden='true'] { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav { transition: none; }
    .site-nav[data-hidden='true'] { transform: none; }
  }

  /* --- Mobile toggle (hidden on desktop) --- */
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    padding: 10px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }
  .nav-toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--ink);
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .nav-toggle-bar {
    background: var(--butter);
  }

  /* Open: lift the bar above the overlay/panel so the close control is visible
     and tappable, and morph the hamburger into an X. */
  .site-nav[data-menu-open='true'] { z-index: 1300; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Order pill as rendered inside the mobile panel (slotted into MobilePanel). */
  .order-cta--block {
    margin-top: var(--space-4);
    justify-content: center;
    min-height: 48px;
    font-size: clamp(14px, calc(14px + (100vw - 1920px) * 0.003125), 16px);
  }

  /* --- Breakpoint --- */
  @media (max-width: 860px) {
    .nav-links,
    .nav-right .order-cta {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Nav behavior: scroll state + hide-on-scroll. The mobile panel's
  // open/close behavior lives in MobilePanel.astro.
  // Bound per page-load: with view transitions the nav DOM is swapped on every
  // navigation, so a run-once module leaves the fresh nav with NO scroll
  // listener → data-scrolled never flips → the bar sits transparent over light
  // content. init() re-queries and re-binds; the window listener is cleaned up
  // before re-adding so navigations can't stack handlers.
  let cleanupScroll: (() => void) | null = null;

  function initNav() {
    const nav = document.querySelector<HTMLElement>('.site-nav');
    // Guard on element identity: first load fires BOTH the ready path and
    // astro:page-load; a second bind on the same nav would double every click
    // handler. After a swap the fresh nav has no flag, so it binds again.
    if (!nav || nav.dataset.navBound === 'true') return;
    nav.dataset.navBound = 'true';
    cleanupScroll?.(); // drop the stale window listener from the previous page

    // --- Scroll glass + hide-on-scroll-down / show-on-scroll-up (rAF throttled) ---
    if (nav) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mobileBar = window.matchMedia('(max-width: 768px)');
      let ticking = false;
      let lastY = window.scrollY;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          nav.dataset.scrolled = y > 8 ? 'true' : 'false';
          // Hide-on-scroll is DESKTOP ONLY (on iOS the toolbar collapse makes a
          // moving bar feel broken); 8px delta so tiny jitters never toggle it.
          if (!reduce && !mobileBar.matches && nav.dataset.menuOpen !== 'true') {
            const delta = y - lastY;
            if (delta > 8 && y > 120) nav.dataset.hidden = 'true';
            else if (delta < -8) nav.dataset.hidden = 'false';
          }
          lastY = y;
          ticking = false;
        });
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      cleanupScroll = () => window.removeEventListener('scroll', onScroll);
    }
  }

  // First load (no page-load event when transitions are off) + every swap.
  if (document.readyState !== 'loading') initNav();
  else document.addEventListener('DOMContentLoaded', initNav, { once: true });
  document.addEventListener('astro:page-load', initNav);
</script>
