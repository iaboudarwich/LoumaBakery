---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Wordmark } from '../lib/brand';
import FaceDraw from '../components/FaceDraw.astro';

const c = (await getEntry('copy', 'notFound'))!.data;
---

<BaseLayout title="Not found" description={c.lede}>
  <section class="nf">
    <div class="container nf-inner">
      <div class="nf-lockup">
        <FaceDraw class="nf-mark" width={84} height={78} color="var(--red)" />
        <Wordmark class="nf-wordmark" width={150} height={96} aria-label={c.title} />
      </div>
      <p class="label nf-label">{c.eyebrow}</p>
      <h1 class="display nf-title">{c.title}</h1>
      {c.lede && <p class="nf-lede">{c.lede}</p>}
      {c.cta && <a class="btn btn-primary nf-cta" href={c.cta.href}>{c.cta.label}</a>}
    </div>
  </section>
</BaseLayout>

<style>
  /* Global system (tokens.css): container, --section-y rhythm, --fs-* scale. */
  .nf {
    min-height: calc(100vh - var(--nav-h)); /* fallback */
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: var(--section-y);
  }
  .nf-inner { display: flex; flex-direction: column; align-items: center; }
  .nf-lockup { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); margin-bottom: var(--block-gap); }
  .nf-mark { color: var(--red); }
  .nf-wordmark { color: var(--burgundy); height: auto; }
  .nf-label { color: var(--burgundy); }
  .nf-title { margin-top: var(--space-5); }
  .nf-lede { margin-top: var(--block-gap); font-size: var(--fs-lead); color: var(--burgundy); max-width: 34em; }
  .nf-cta { margin-top: var(--block-gap); }
</style>
